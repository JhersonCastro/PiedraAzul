@using PiedraAzul.Client.Models.Admin
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.AdminServices
@using PiedraAzul.Client.UI.Features.Admin.Components
@inject UserManagementService UserSvc
@inject IJSRuntime JS

<div class="admin-page">
    <div class="admin-inner">

        <!-- Header -->
        <div data-tour="admin-user-management-header" class="portal-section-header mb-6">
            <div>
                <h1 class="admin-heading">Gestión de usuarios</h1>
                <p class="admin-sub">
                    Administrar el acceso al sistema, los protocolos de seguridad y los roles del equipo médico.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button @onclick="OpenCreateModal" class="btn-action-inline">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon-4" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z" />
                    </svg>
                    Nuevo usuario
                </button>
            </div>
        </div>

        <!-- Toasts -->
        @if (!string.IsNullOrEmpty(_toast))
        {
            <div class="toast-ok">
                <svg class="icon-6 flex-shrink-0 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                @_toast
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorToast))
        {
            <div class="toast-err">
                <svg class="icon-6 flex-shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                @_errorToast
            </div>
        }

        <!-- Filtros -->
        <div class="filter-card mb-6 flex flex-wrap items-end gap-4">
            <div class="flex-grow min-w-[220px]">
                <label class="filter-label">Buscar</label>
                <div class="search-input-wrap">
                    <div class="search-icon">
                        <svg class="icon-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                    <input type="text" value="@_filter.SearchText"
                           @oninput="OnSearchInput"
                           class="search-input"
                           placeholder="Nombre, correo, teléfono..." />
                </div>
            </div>

            <div class="w-44">
                <label class="filter-label">Rol</label>
                <select @bind="_filter.RoleFilter" @bind:after="ReloadAsync" class="input-slate-select">
                    <option value="">Todos los roles</option>
                    <option value="Patient">Paciente</option>
                    <option value="Admin">Administrador</option>
                    <option value="Doctor">Doctor / Terapista</option>
                </select>
            </div>

            <div class="w-40">
                <label class="filter-label">Estado</label>
                <select @bind="_filter.StatusFilter" @bind:after="ReloadAsync" class="input-slate-select">
                    <option value="">Todos</option>
                    <option value="Active">Activos</option>
                    <option value="Inactive">Inactivos</option>
                </select>
            </div>

            <div>
                <button @onclick="ClearFiltersAsync"
                        class="py-2.5 px-2 text-sm font-semibold text-[#257D8D] transition-colors hover:text-[#1E5F6F]">
                    Limpiar<br />filtros
                </button>
            </div>
        </div>

        <!-- Tabla -->
        <div class="table-card mb-8">
            <div class="table-scroll">
                <table class="table-base">
                    <thead>
                        <tr class="table-head-row">
                            <th class="table-th">Nombre</th>
                            <th class="table-th">Correo / Tel</th>
                            <th class="table-th">Rol</th>
                            <th class="table-th">Estado</th>
                            <th class="table-th">Creado</th>
                            <th class="px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="table-body">
                        @if (_loading)
                        {
                            <tr><td colspan="6" class="py-16 text-center"><div class="loading-center-sm"><svg class="h-8 w-8 animate-spin text-[#257D8D]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/></svg></div></td></tr>
                        }
                        else if (_result.Users.Count == 0)
                        {
                            <tr><td colspan="6" class="table-empty">No se encontraron usuarios</td></tr>
                        }
                        else
                        {
                            @foreach (var user in _result.Users)
                            {
                                <tr class="table-row">
                                    <td class="table-td">
                                        <div class="text-sm font-bold text-slate-900">@user.Name</div>
                                        @if (!string.IsNullOrEmpty(user.DoctorTypeLabel))
                                        {
                                            <div class="mt-0.5 text-xs text-slate-400">@user.DoctorTypeLabel</div>
                                        }
                                    </td>
                                    <td class="table-td text-sm text-slate-500">
                                        <div>@user.Email</div>
                                        @if (!string.IsNullOrEmpty(user.Phone))
                                        {
                                            <div class="mt-0.5 text-xs text-slate-400">@user.Phone</div>
                                        }
                                    </td>
                                    <td class="table-td">
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="mr-1 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-bold @RoleBadgeClass(role)">
                                                @RoleLabel(role)
                                            </span>
                                        }
                                    </td>
                                    <td class="table-td">
                                        @if (user.IsActive)
                                        {
                                            <span class="inline-flex rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-700">ACTIVO</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-500">INACTIVO</span>
                                        }
                                    </td>
                                    <td class="table-td text-xs text-slate-400">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="table-td">
                                        <div class="flex items-center justify-center gap-2">
                                            <button @onclick="() => OpenUserDetailModal(user)" title="Ver detalle"
                                                    class="rounded p-1 text-slate-400 transition-colors hover:text-[#257D8D]">
                                                <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                            </button>
                                            <button @onclick="() => OpenEditModal(user)" title="Editar"
                                                    class="rounded p-1 text-slate-400 transition-colors hover:text-[#257D8D]">
                                                <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            </button>
                                            <button @onclick="() => OnToggleStatusClick(user)"
                                                    title="@(user.IsActive ? "Inhabilitar" : "Activar")"
                                                    class="rounded p-1 transition-colors @(user.IsActive ? "text-amber-400 hover:text-amber-600" : "text-emerald-400 hover:text-emerald-600")">
                                                @if (user.IsActive)
                                                {
                                                    <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"/></svg>
                                                }
                                                else
                                                {
                                                    <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                                                }
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            @if (!_loading && _result.TotalCount > 0)
            {
                <div class="table-footer flex-wrap gap-3">
                    <div class="table-count">
                        Mostrando <span class="font-bold text-slate-700">@((_filter.PageNumber - 1) * _filter.PageSize + 1)–@Math.Min(_filter.PageNumber * _filter.PageSize, _result.TotalCount)</span>
                        de <span class="font-bold text-slate-700">@_result.TotalCount</span> usuarios
                    </div>
                    <div class="pagination">
                        <button @onclick="PrevPage" disabled="@(_filter.PageNumber <= 1)" class="page-btn">
                            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        @for (int p = 1; p <= _result.TotalPages; p++)
                        {
                            var pageNum = p;
                            <button @onclick="() => GoToPage(pageNum)"
                                    class="@(_filter.PageNumber == pageNum ? "page-btn-active" : "page-btn-idle")">
                                @pageNum
                            </button>
                        }
                        <button @onclick="NextPage" disabled="@(_filter.PageNumber >= _result.TotalPages)" class="page-btn">
                            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Modal contraseña temporal -->
        @if (_showTempPassword)
        {
            <div class="modal-overlay-center" style="z-index:60">
                <div class="fixed inset-0 bg-black/40" @onclick="() => _showTempPassword = false"></div>
                <div class="modal-card-sm relative z-10 border border-slate-100">
                    <h3 class="mb-2 text-lg font-bold text-slate-900">✅ Usuario creado</h3>
                    <p class="mb-4 text-sm text-slate-600">
                        Comparte esta contraseña temporal con el usuario. Solo se mostrará una vez.
                    </p>
                    <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
                        <code class="flex-1 font-mono text-lg font-bold text-[#257D8D]">@_tempPassword</code>
                        <button @onclick="CopyPassword" class="text-slate-400 transition-colors hover:text-[#257D8D]">
                            <svg class="icon-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                        </button>
                    </div>
                    <button @onclick="() => _showTempPassword = false"
                            class="mt-4 w-full rounded-lg bg-[#257D8D] py-2 text-sm font-bold text-white transition-colors hover:bg-[#1E5F6F]">
                        Entendido
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal crear/editar -->
<UserFormModal IsOpen="_modalOpen"
               IsEditMode="_editMode"
               SelectedUser="_selectedUser"
               OnSave="HandleModalSave"
               OnCancel="HandleModalCancel"
               @ref="_modal" />

<!-- Modal detalle de usuario -->
<AdminUserDetailModal User="_detailUser"
                      IsOpen="_showDetailModal"
                      OnClose="CloseUserDetailModal" />

<!-- Modal confirmar inhabilitación -->
@if (_deactivateUser is not null)
{
    <div class="modal-overlay-center" style="z-index:60">
        <div class="fixed inset-0 bg-black/40" @onclick="CloseDeactivateConfirm"></div>
        <div class="modal-card-sm relative z-10 border border-slate-100">
            <div class="modal-icon-danger bg-amber-100">
                <svg class="icon-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6" />
                </svg>
            </div>

            <h3 class="modal-title-center">¿Inhabilitar a @_deactivateUser.Name?</h3>

            <div class="alert alert-amber mt-3 text-[12px] leading-relaxed">
                <div>
                    <p class="font-semibold">El usuario no se elimina de la base de datos.</p>
                    <p class="mt-1">
                        Se da de baja de forma <strong>lógica y reversible</strong>: la cuenta queda
                        inhabilitada y el usuario no podrá iniciar sesión. Su información e historial de
                        citas se conservan, y podrás <strong>volver a activarlo</strong> cuando quieras.
                    </p>
                </div>
            </div>

            <div class="modal-actions">
                <button @onclick="CloseDeactivateConfirm"
                        disabled="@_deactivateLoading"
                        class="btn-modal-cancel">
                    Cancelar
                </button>
                <button @onclick="ConfirmDeactivateAsync"
                        disabled="@_deactivateLoading"
                        class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-amber-500 py-2.5 text-[13px] font-bold text-white transition hover:bg-amber-600 disabled:opacity-60">
                    @if (_deactivateLoading)
                    {
                        <span class="spinner-inline"></span>
                    }
                    Inhabilitar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private UserListResultGQL _result = new();
    private UserFilterModel _filter = new();
    private bool _loading;

    private bool _modalOpen;
    private bool _editMode;
    private AdminUserGQL? _selectedUser;
    private UserFormModal? _modal;

    private bool _showDetailModal;
    private AdminUserGQL? _detailUser;

    private AdminUserGQL? _deactivateUser;
    private bool _deactivateLoading;

    private string? _toast;
    private string? _errorToast;
    private bool _showTempPassword;
    private string? _tempPassword;

    private System.Timers.Timer? _searchDebounce;
    private System.Timers.Timer? _toastTimer;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        StateHasChanged();

        var result = await UserSvc.GetUsersAsync(_filter);
        if (result.IsSuccess)
            _result = result.Value!;
        else
            ShowError(result.Error?.Message ?? "Error al cargar usuarios");

        _loading = false;
        StateHasChanged();
    }

    // ─── Búsqueda con debounce ──────────────────────────────────
    private void OnSearchInput(ChangeEventArgs e)
    {
        _filter.SearchText = e.Value?.ToString();
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Timers.Timer(400);
        _searchDebounce.Elapsed += async (_, _) =>
        {
            _searchDebounce?.Dispose();
            _filter.PageNumber = 1;
            await InvokeAsync(ReloadAsync);
        };
        _searchDebounce.AutoReset = false;
        _searchDebounce.Start();
    }

    private async Task ClearFiltersAsync()
    {
        _filter = new UserFilterModel();
        await ReloadAsync();
    }

    // ─── Paginación ─────────────────────────────────────────────
    private async Task PrevPage()  { if (_filter.PageNumber > 1) { _filter.PageNumber--; await ReloadAsync(); } }
    private async Task NextPage()  { if (_filter.PageNumber < _result.TotalPages) { _filter.PageNumber++; await ReloadAsync(); } }
    private async Task GoToPage(int p) { _filter.PageNumber = p; await ReloadAsync(); }

    // ─── Modal ──────────────────────────────────────────────────
    private void OpenCreateModal()
    {
        _editMode = false;
        _selectedUser = null;
        _modalOpen = true;
    }

    private void OpenEditModal(AdminUserGQL user)
    {
        _editMode = true;
        _selectedUser = user;
        _modalOpen = true;
    }

    // ─── Modal detalle ──────────────────────────────────────────
    private void OpenUserDetailModal(AdminUserGQL user)
    {
        _detailUser = user;
        _showDetailModal = true;
    }

    private void CloseUserDetailModal()
    {
        _showDetailModal = false;
        _detailUser = null;
    }

    private async Task HandleModalSave(object payload)
    {
        if (payload is UserCreateModel create)
        {
            var result = await UserSvc.CreateUserAsync(create);
            if (!result.IsSuccess)
            {
                _modal?.SetError(result.Error?.Message ?? "Error al crear usuario");
                return;
            }
            _modalOpen = false;
            _tempPassword = result.Value?.TempPassword;
            _showTempPassword = !string.IsNullOrEmpty(_tempPassword);
            ShowSuccess("Usuario creado correctamente");
            await ReloadAsync();
        }
        else if (payload is UserEditModel edit)
        {
            var result = await UserSvc.UpdateUserAsync(edit);
            if (!result.IsSuccess)
            {
                _modal?.SetError(result.Error?.Message ?? "Error al actualizar usuario");
                return;
            }
            _modalOpen = false;
            ShowSuccess("Usuario actualizado correctamente");
            await ReloadAsync();
        }
    }

    private void HandleModalCancel() => _modalOpen = false;

    // ─── Inhabilitar / Activar (única acción de baja, reversible) ─
    private void OnToggleStatusClick(AdminUserGQL user)
    {
        // Activar es directo; inhabilitar muestra el modal explicativo.
        if (user.IsActive)
            _deactivateUser = user;
        else
            _ = ToggleStatusAsync(user);
    }

    private void CloseDeactivateConfirm()
    {
        if (_deactivateLoading) return;
        _deactivateUser = null;
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateUser is null) return;

        _deactivateLoading = true;
        StateHasChanged();

        var user = _deactivateUser;
        await ToggleStatusAsync(user);

        _deactivateLoading = false;
        _deactivateUser = null;
    }

    private async Task ToggleStatusAsync(AdminUserGQL user)
    {
        var result = await UserSvc.ToggleUserStatusAsync(user.Id);
        if (!result.IsSuccess)
        {
            ShowError(result.Error?.Message ?? "Error al cambiar estado");
            return;
        }
        var updated = result.Value!;
        ShowSuccess(updated.IsActive ? "Usuario activado" : "Usuario inhabilitado. Su historial se conserva.");
        await ReloadAsync();
    }

    // ─── Copiar contraseña ──────────────────────────────────────
    private async Task CopyPassword()
    {
        if (!string.IsNullOrEmpty(_tempPassword))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _tempPassword);
    }

    // ─── Toast helpers ──────────────────────────────────────────
    private void ShowSuccess(string msg)
    {
        _toast = msg;
        _errorToast = null;
        _toastTimer?.Dispose();
        _toastTimer = new System.Timers.Timer(3000);
        _toastTimer.Elapsed += (_, _) => { _toast = null; InvokeAsync(StateHasChanged); };
        _toastTimer.AutoReset = false;
        _toastTimer.Start();
        StateHasChanged();
    }

    private void ShowError(string msg)
    {
        _errorToast = msg;
        _toast = null;
        _toastTimer?.Dispose();
        _toastTimer = new System.Timers.Timer(5000);
        _toastTimer.Elapsed += (_, _) => { _errorToast = null; InvokeAsync(StateHasChanged); };
        _toastTimer.AutoReset = false;
        _toastTimer.Start();
        StateHasChanged();
    }

    // ─── Helpers visuales ───────────────────────────────────────
    private static string RoleBadgeClass(string role) => role switch
    {
        "Doctor"  => "bg-blue-50 text-blue-600 border border-blue-100",
        "Admin"   => "bg-amber-50 text-amber-600 border border-amber-100",
        "Patient" => "bg-slate-100 text-slate-600",
        _         => "bg-slate-100 text-slate-500"
    };

    private static string RoleLabel(string role) => role switch
    {
        "Doctor"  => "Doctor",
        "Admin"   => "Admin",
        "Patient" => "Paciente",
        _         => role
    };

    public void Dispose()
    {
        _searchDebounce?.Dispose();
        _toastTimer?.Dispose();
    }
}
