@using PiedraAzul.Client.Models.Admin
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Contracts.Enums
@using PiedraAzul.Contracts.Validation

@if (IsOpen)
{
    <!-- Backdrop -->
    <div class="modal-backdrop" @onclick="HandleCancel"></div>

    <!-- Modal -->
    <div class="modal-container">
        <div class="modal-panel-lg"
             @onclick:stopPropagation>

            <!-- Header -->
            <div class="modal-header">
                <h2 class="modal-title-sm text-lg">
                    @(IsEditMode ? "Editar usuario" : "Crear nuevo usuario")
                </h2>
                <button @onclick="HandleCancel"
                        class="btn-close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body space-y-4">

                @if (!string.IsNullOrEmpty(_errorMsg))
                {
                    <div class="alert-error-inline">
                        @_errorMsg
                    </div>
                }

                <!-- Nombre -->
                <div>
                    <label class="label-sm">Nombre completo *</label>
                    <input type="text" @bind="_fullName"
                           class="input-slate"
                           placeholder="Ej: María García" />
                </div>

                <!-- Documento -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="label-sm">Tipo de documento *</label>
                        <select @bind="_documentType" class="input-slate-select">
                            <option value="CC">Cédula de ciudadanía</option>
                            <option value="TI">Tarjeta de identidad</option>
                            <option value="CE">Cédula de extranjería</option>
                            <option value="PA">Pasaporte</option>
                        </select>
                    </div>
                    <div>
                        <label class="label-sm">Número de documento *</label>
                        <input type="text" @bind="_identification"
                               class="input-slate"
                               placeholder="Ej: 1150064123" />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label class="label-sm">Correo electrónico *</label>
                    <input type="email" @bind="_email"
                           class="input-slate"
                           placeholder="correo@ejemplo.com" />
                </div>

                <!-- Teléfono -->
                <div>
                    <label class="label-sm">Celular *</label>
                    <input type="text" @bind="_phone"
                           class="input-slate"
                           placeholder="Celular colombiano, ej: 300 123 4567" />
                </div>

                <!-- Fecha nacimiento + Género -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="label-sm">Fecha de nacimiento *</label>
                        <input type="date" @bind="_birthDate"
                               class="input-slate" />
                    </div>
                    <div>
                        <label class="label-sm">Género</label>
                        <select @bind="_gender" class="input-slate-select">
                            <option value="NON_SPECIFIED">Prefiero no decir</option>
                            <option value="MALE">Hombre</option>
                            <option value="FEMALE">Mujer</option>
                            <option value="OTHER">Otro</option>
                        </select>
                    </div>
                </div>

                <!-- Rol -->
                <div>
                    <label class="label-sm">Rol *</label>
                    <select @bind="_role"
                            class="input-slate-select">
                        <option value="Patient">Paciente</option>
                        <option value="Admin">Administrador</option>
                        <option value="Doctor">Doctor / Terapista</option>
                    </select>
                </div>

                <!-- Tipo doctor (condicional) -->
                @if (_role == "Doctor")
                {
                    <div>
                        <label class="label-sm">Tipo de especialidad</label>
                        <select @bind="_doctorType"
                                class="input-slate-select">
                            <option value="NATURAL_MEDICINE">Medicina Natural</option>
                            <option value="CHIROPRACTIC">Quiropráctica</option>
                            <option value="OPTOMETRY">Optometría</option>
                            <option value="PHYSIOTHERAPY">Fisioterapia</option>
                        </select>
                    </div>
                }

                <!-- Estado (solo en creación) -->
                @if (!IsEditMode)
                {
                    <div class="flex items-center gap-3">
                        <button type="button" @onclick="ToggleActive"
                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none @(_isActive ? "bg-[#257D8D]" : "bg-slate-300")">
                            <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform @(_isActive ? "translate-x-6" : "translate-x-1")"></span>
                        </button>
                        <span class="text-sm font-medium text-slate-700">
                            @(_isActive ? "Cuenta activa" : "Cuenta inactiva")
                        </span>
                    </div>
                }

            </div>

            <!-- Footer -->
            <div class="modal-footer flex items-center justify-end gap-3">
                <button @onclick="HandleCancel"
                        class="btn-cancel">
                    Cancelar
                </button>
                <button @onclick="HandleSave" disabled="@_saving"
                        class="btn-action-inline">
                    @if (_saving)
                    {
                        <svg class="icon-4 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
                        </svg>
                    }
                    @(IsEditMode ? "Guardar cambios" : "Crear usuario")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public AdminUserGQL? SelectedUser { get; set; }
    [Parameter] public EventCallback<object> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _fullName = "";
    private string _email = "";
    private string _phone = "";
    private string _identification = "";
    private string _documentType = "CC";
    private string _gender = "NON_SPECIFIED";
    private DateTime? _birthDate;
    private string _role = "Patient";
    private string _doctorType = "NaturalMedicine";
    private bool _isActive = true;
    private bool _saving;
    private string? _errorMsg;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _errorMsg = null;

            if (IsEditMode && SelectedUser is not null)
            {
                _fullName       = SelectedUser.Name;
                _email          = SelectedUser.Email;
                _phone          = SelectedUser.Phone;
                _identification = SelectedUser.IdentificationNumber;
                _documentType   = string.IsNullOrEmpty(SelectedUser.DocumentType) ? "CC" : SelectedUser.DocumentType;
                _gender         = string.IsNullOrEmpty(SelectedUser.Gender) ? "NON_SPECIFIED" : SelectedUser.Gender;
                _birthDate      = SelectedUser.BirthDate;
                _role           = SelectedUser.PrimaryRole;
                _doctorType     = SelectedUser.DoctorType ?? "NATURAL_MEDICINE";
                _isActive       = SelectedUser.IsActive;
            }
            else
            {
                _fullName       = "";
                _email          = "";
                _phone          = "";
                _identification = "";
                _documentType   = "CC";
                _gender         = "NON_SPECIFIED";
                _birthDate      = null;
                _role           = "Patient";
                _doctorType     = "NATURAL_MEDICINE";
                _isActive       = true;
                _saving         = false;
            }
        }
    }

    private void ToggleActive() => _isActive = !_isActive;

    private async Task HandleSave()
    {
        _errorMsg = null;

        if (string.IsNullOrWhiteSpace(_fullName))  { _errorMsg = "El nombre es requerido"; return; }
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@') || !_email.Contains('.'))
        { _errorMsg = "Correo inválido"; return; }

        if (string.IsNullOrWhiteSpace(_identification)) { _errorMsg = "La cédula / documento es requerido"; return; }

        var docType = Enum.TryParse<DocumentType>(_documentType, out var dt) ? dt : DocumentType.CC;
        if (!ColombianValidation.IsValidDocumentNumber(docType, _identification))
        { _errorMsg = ColombianValidation.DocumentNumberError(docType); return; }

        if (!ColombianValidation.IsValidMobile(_phone))
        { _errorMsg = "Ingresa un celular colombiano válido (10 dígitos, empieza por 3)."; return; }

        if (_birthDate is null) { _errorMsg = "La fecha de nacimiento es requerida"; return; }
        if (!ColombianValidation.IsAtLeastAge(_birthDate, ColombianValidation.MinRegistrationAge))
        { _errorMsg = $"El usuario debe tener al menos {ColombianValidation.MinRegistrationAge} años"; return; }

        var birthUtc = DateTime.SpecifyKind(_birthDate.Value, DateTimeKind.Utc);

        _saving = true;

        try
        {
            if (IsEditMode)
            {
                var edit = new UserEditModel
                {
                    UserId               = SelectedUser!.Id,
                    FullName             = _fullName,
                    Email                = _email,
                    Phone                = _phone,
                    IdentificationNumber = _identification,
                    DocumentType         = _documentType,
                    Gender               = _gender,
                    BirthDate            = birthUtc,
                    Role                 = _role,
                    DoctorType           = _role == "Doctor" ? _doctorType : null
                };
                await OnSave.InvokeAsync(edit);
            }
            else
            {
                var create = new UserCreateModel
                {
                    FullName             = _fullName,
                    Email                = _email,
                    Phone                = _phone,
                    IdentificationNumber = _identification,
                    DocumentType         = _documentType,
                    Gender               = _gender,
                    BirthDate            = birthUtc,
                    Role                 = _role,
                    DoctorType           = _role == "Doctor" ? _doctorType : null,
                    IsActive             = _isActive
                };
                await OnSave.InvokeAsync(create);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleCancel() => await OnCancel.InvokeAsync();

    public void SetError(string msg)
    {
        _errorMsg = msg;
        _saving = false;
        StateHasChanged();
    }
}
