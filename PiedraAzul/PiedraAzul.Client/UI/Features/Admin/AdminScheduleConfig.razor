@page "/admin/configurar-horario"
@layout PiedraAzul.Client.UI.Shared.Layout.EmptyLayout
@using PiedraAzul.Client.Models.Schedule
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.Schedule
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Contracts.Enums
@using PiedraAzul.Client.States
@using PiedraAzul.Client.UI.Shared.Components
@inject UserState UserState
@inject IJSRuntime JS
@inject GraphQLDoctorService DoctorService
@inject IScheduleConfigService ScheduleConfigService

<div class="bg-slate-50 pb-12">

    <main class="max-w-7xl mx-auto px-4 pt-2">
        <EditForm Model="EditModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <div class="flex flex-col gap-6 mb-8">
                <div class="flex items-center gap-4">
                    <button @onclick="GoBack" type="button" class="p-3 bg-white border border-slate-200 rounded-2xl text-slate-400 hover:text-primary transition-all shadow-sm flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                    <div>
                        <h1 class="text-2xl md:text-4xl font-black text-slate-900 mb-1">Configurar Horario</h1>
                        <p class="text-slate-500 text-sm md:text-base font-medium">Gestiona la disponibilidad semanal para citas con pacientes.</p>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Especialista</label>
                    <DoctorAutocomplete Doctors="Doctors"
                                        Value="@EditModel.DoctorId"
                                        ValueChanged="OnSpecialistAutocompleteChanged"
                                        ValueSelector="d => d.UserId"
                                        Placeholder="Busca por nombre o especialidad..." />
                    <ValidationMessage For="() => EditModel.DoctorId" class="text-red-500 text-xs ml-1" />
                </div>
            </div>

            

            <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-10">
                <aside class="space-y-4">
                    <!-- Leyenda -->
                    <div class="portal-card">
                        <p class="portal-card-title mb-4 uppercase tracking-wider">Leyenda</p>
                        <div class="space-y-3">
                            <div class="legend-item">
                                <div class="legend-dot-primary"></div>
                                <span class="legend-text">Disponible</span>
                            </div>
                            <div class="legend-item">
                                <div class="legend-dot-idle"></div>
                                <span class="legend-text">Bloqueado</span>
                            </div>
                            <div class="legend-item">
                                <div class="h-3 w-3 rounded-full border border-amber-300 bg-amber-100"></div>
                                <span class="legend-text">Eliminado (reactivable)</span>
                            </div>
                        </div>
                        <p class="mt-4 text-xs text-[#94A3B8]">Clic en una franja de @EditModel.IntervalMinutes min para cambiar disponibilidad.</p>
                    </div>

                    <!-- Intervalo + Franja Horaria -->
                    <div class="grid grid-cols-2 gap-4">
                        <div class="portal-card">
                            <p class="portal-card-title mb-3 uppercase tracking-wider">Intervalo</p>
                            <select value="@EditModel.IntervalMinutes" @onchange="OnIntervalChanged" class="sched-input">
                                <option value="5">5 min</option>
                                <option value="10">10 min</option>
                                <option value="15">15 min</option>
                                <option value="20">20 min</option>
                                <option value="30">30 min</option>
                                <option value="60">60 min</option>
                            </select>
                            <p class="mt-2 text-[11px] text-[#94A3B8]">@EditModel.IntervalMinutes min por slot</p>
                        </div>

                        <div class="portal-card">
                            <p class="portal-card-title mb-3 uppercase tracking-wider">Franja Horaria</p>
                            <div class="space-y-3">
                                <div>
                                    <label class="mb-1 block text-[11px] text-[#64748B]">Apertura</label>
                                    <input type="time" value="@StartTimeText" @onchange="OnStartTimeChanged" class="sched-input" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-[11px] text-[#64748B]">Cierre</label>
                                    <input type="time" value="@EndTimeText" @onchange="OnEndTimeChanged" class="sched-input" />
                                </div>
                            </div>
                            <p class="mt-2 text-[11px] text-[#94A3B8]">Se aplica a todos los días habilitados.</p>
                        </div>
                    </div>

                    <!-- Ventana de reserva (exclusivo de Admin) -->
                    <div class="portal-card">
                        <p class="portal-card-title mb-3 uppercase tracking-wider">Ventana de reserva</p>
                        <select @bind="EditModel.BookingWindowWeeks" class="sched-input">
                            @for (var week = 1; week <= 8; week++)
                            {
                                <option value="@week">@week semana(s)</option>
                            }
                        </select>
                        <p class="mt-2 text-[11px] text-[#94A3B8]">Cuántas semanas hacia adelante pueden reservar los pacientes.</p>
                    </div>
                </aside>

                <div class="space-y-8">
                    @if (string.IsNullOrWhiteSpace(EditModel.DoctorId))
                    {
                        <div class="bg-white rounded-[2.5rem] p-16 shadow-sm border border-slate-100 flex flex-col items-center justify-center min-h-[400px]">
                            <div class="text-center">
                                <div class="text-slate-400 mb-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                </div>
                                        <h3 class="text-xl md:text-3xl font-black text-slate-900 mb-3">Selecciona un especialista</h3>
                                <p class="text-slate-500 font-medium text-sm md:text-lg mb-8 max-w-md">Para mostrar y modificar la franja horaria de disponibilidad, primero debes seleccionar un especialista en el selector de arriba.</p>
                                <button type="button" @onclick="ScrollToTop" class="bg-primary text-white px-12 py-4 rounded-2xl font-bold hover:opacity-90 transition-all">
                                    Ir a selector
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-white rounded-2xl md:rounded-[2.5rem] shadow-xl shadow-slate-200/40 border border-slate-100 overflow-hidden">
                      <div class="overflow-x-auto">
                       <div class="min-w-[560px]">
                        <div class="grid grid-cols-[100px_1fr_1fr_1fr_1fr_1fr] border-b border-slate-100 bg-slate-50/20">
                            <div class="p-5 flex items-center justify-center text-[10px] font-black text-slate-400 uppercase tracking-widest border-r border-slate-100">Horario</div>
                            @foreach (var day in WeekDays)
                            {
                                <div class="p-5 border-r border-slate-100 last:border-0 text-center relative group @(day.IsBlocked ? "bg-slate-50/50" : "")">
                                    <button type="button" @onclick="() => ToggleDay(day.DayName)" class="block w-full text-center hover:opacity-70 transition-all">
                                        <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">@day.DayName</div>
                                    </button>
                                    <div class="flex justify-center">
                                        <label class="relative inline-flex items-center cursor-pointer group">
                                            <input type="checkbox" checked="@(!day.IsBlocked)" @onchange="() => ToggleDay(day.DayName)" class="sr-only peer">
                                            <div class="w-12 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                                        </label>
                                    </div>
                                    @if (!day.IsBlocked)
                                    {
                                        <div class="absolute inset-x-0 bottom-0 h-1.5 bg-primary"></div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="divide-y divide-slate-100">
                            @foreach (var hour in Hours)
                            {
                                <div class="grid grid-cols-[100px_1fr_1fr_1fr_1fr_1fr]">
                                    <div class="p-5 flex items-start justify-center font-black text-slate-900 text-base border-r border-slate-100">@hour</div>
                                    @foreach (var day in WeekDays)
                                    {
                                        <div class="p-4 border-r border-slate-100 last:border-0 @(day.IsBlocked ? "bg-slate-50/50 flex items-center justify-center italic text-slate-400 font-bold text-sm" : "")">
                                            @if (day.IsBlocked)
                                            {
                                                <span>Bloqueado</span>
                                            }
                                            else
                                            {
                                                <div class="grid grid-cols-1 gap-3">
                                                    @foreach (var slot in GetSlotsForHour(day, hour))
                                                    {
                                                        <button type="button" @onclick="() => ToggleSlot(day, slot)"
                                                                class="w-full py-3.5 px-6 rounded-2xl text-[11px] font-black transition-all border flex items-center justify-between group
                                                                       @(slot.IsActive ? "bg-primary text-white border-primary shadow-xl shadow-primary/20" : slot.IsDeletedInDb ? "bg-amber-50 text-amber-400 border-amber-200 line-through hover:border-amber-400" : "bg-white text-slate-300 border-slate-100 hover:border-slate-300")">
                                                            <span>@slot.StartTime</span>
                                                            @if (!slot.IsActive && slot.IsDeletedInDb)
                                                            {
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-60"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                                                            }
                                                            else if (!slot.IsActive)
                                                            {
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                       </div>
                      </div>
                    </div>

             @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
            {
                <div class="mb-6 rounded-2xl px-5 py-4 font-bold text-sm @(IsErrorFeedback ? "bg-red-50 text-red-700 border border-red-100" : "bg-emerald-50 text-emerald-700 border border-emerald-100")">
                    @FeedbackMessage
                </div>
            }

                    <div class="actions-end-row pt-6">
                        <button type="button" @onclick="CancelChanges" class="bg-white border-2 border-slate-100 px-6 py-3 rounded-2xl font-black text-slate-600 hover:bg-slate-50 transition-all uppercase tracking-widest text-xs">
                            Cancelar
                        </button>
                        <button type="submit" disabled="@IsSaving" class="btn-save disabled:cursor-not-allowed">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                            @(IsSaving ? "GUARDANDO..." : "GUARDAR")
                        </button>
                    </div>
                    }
                </div>
            </div>
        </EditForm>
    </main>
</div>

@code {
    private readonly List<DayScheduleModel> WeekDays = new();
    private readonly List<string> Hours = new();
    private List<DoctorGQL> Doctors = new();
    private ScheduleConfigEditModel EditModel { get; set; } = new();
    private bool showConfigPopover;
    private bool IsSaving;
    private string? FeedbackMessage;
    private bool IsErrorFeedback;
    private string StartTimeText { get; set; } = "08:00";
    private string EndTimeText { get; set; } = "17:00";

    private const string SelectedMonthLabel = "Semana";

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");

    private async Task ScrollToTop() => await JS.InvokeVoidAsync("window.scrollTo", 0, 0);

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
        EnsureAvailabilityDays();
        SyncTimeRangeInputs();
        RebuildSlots();
    }

    private async Task LoadDoctorsAsync()
    {
        Doctors = new();

        for (var i = 0; i <= 3; i++)
        {
            var type = (DoctorType)i;
            var result = await DoctorService.GetDoctorsByTypeAsync(type.ToGraphQL());
            if (result.Any())
            {
                Doctors.AddRange(result);
            }
        }

        Doctors = Doctors
            .GroupBy(x => x.UserId)
            .Select(x => x.First())
            .OrderBy(x => x.Name)
            .ToList();
    }

    // Igual que el portal del doctor: al elegir un especialista se carga su horario automáticamente.
    private async Task OnSpecialistAutocompleteChanged(string? userId)
    {
        EditModel.DoctorId = userId ?? string.Empty;
        FeedbackMessage = null;
        if (!string.IsNullOrWhiteSpace(EditModel.DoctorId))
            await LoadSelectedSpecialistConfigAsync();
    }

    private void OnIntervalChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var interval))
        {
            EditModel.IntervalMinutes = Math.Clamp(interval, 5, 60);
            RebuildSlots();
        }
    }

    private void OnStartTimeChanged(ChangeEventArgs args)
    {
        StartTimeText = args.Value?.ToString() ?? StartTimeText;
        ApplyTimeRangeToAvailability();
    }

    private void OnEndTimeChanged(ChangeEventArgs args)
    {
        EndTimeText = args.Value?.ToString() ?? EndTimeText;
        ApplyTimeRangeToAvailability();
    }

    private async Task OnSpecialistSelectedAsync()
    {
        if (string.IsNullOrWhiteSpace(EditModel.DoctorId))
        {
            return;
        }

        await LoadSelectedSpecialistConfigAsync();
    }

    private async Task LoadSelectedSpecialistConfigAsync()
    {
        if (string.IsNullOrWhiteSpace(EditModel.DoctorId))
        {
            return;
        }

        var doctorId = EditModel.DoctorId;
        var loaded = await ScheduleConfigService.GetByDoctorIdAsync(doctorId);
        if (loaded is null)
        {
            return;
        }

        EditModel = ToEditModel(loaded);
        FeedbackMessage = null;
        EditModel.IntervalMinutes = DetectIntervalFromSlots(loaded);
        SyncTimeRangeInputs(loaded);
        RebuildSlots();
    }

    private void EnsureAvailabilityDays()
    {
        EditModel.Availability ??= [];
        foreach (var day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday })
        {
            if (EditModel.Availability.All(x => x.DayOfWeek != day))
            {
                EditModel.Availability.Add(new AvailabilityDayModel { DayOfWeek = day, IsEnabled = true, StartTime = "08:00:00", EndTime = "17:00:00" });
            }
        }
    }

    private void SyncTimeRangeInputs(ScheduleConfigModel? source = null)
    {
        // Si tenemos el modelo original cargado del backend, usarlo directamente.
        // En otros contextos (EnsureAvailabilityDays, etc.) usamos Availability de EditModel.
        if (source is not null)
        {
            var (start, end) = ScheduleConfigHelper.DetectTimeRange(source);
            StartTimeText = $"{start.Hours:00}:{start.Minutes:00}";
            EndTimeText   = $"{end.Hours:00}:{end.Minutes:00}";
            return;
        }

        // Fallback: primer día habilitado en EditModel
        var sample = EditModel.Availability?.FirstOrDefault(x => x.IsEnabled)
                  ?? EditModel.Availability?.FirstOrDefault();
        if (sample is null) { StartTimeText = "08:00"; EndTimeText = "17:00"; return; }
        StartTimeText = $"{sample.StartTimeSpan.Hours:00}:{sample.StartTimeSpan.Minutes:00}";
        EndTimeText   = $"{sample.EndTimeSpan.Hours:00}:{sample.EndTimeSpan.Minutes:00}";
    }

    private void ApplyTimeRangeToAvailability()
    {
        if (!TryParseTime(StartTimeText, out var start) || !TryParseTime(EndTimeText, out var end))
        {
            return;
        }

        foreach (var day in EditModel.Availability)
        {
            day.StartTimeSpan = start;
            day.EndTimeSpan = end;
        }

        RebuildSlots();
    }

    private void RebuildSlots()
    {
        EnsureAvailabilityDays();
        WeekDays.Clear();

        var labels = new Dictionary<DayOfWeek, string>
        {
            [DayOfWeek.Monday] = "Lun",
            [DayOfWeek.Tuesday] = "Mar",
            [DayOfWeek.Wednesday] = "Mier",
            [DayOfWeek.Thursday] = "Jue",
            [DayOfWeek.Friday] = "Vie"
        };

        foreach (var day in EditModel.Availability.Where(x => labels.ContainsKey(x.DayOfWeek)).OrderBy(x => x.DayOfWeek))
        {
            var daySchedule = new DayScheduleModel
            {
                DayName = labels[day.DayOfWeek],
                DayOfWeek = day.DayOfWeek,
                IsBlocked = !day.IsEnabled
            };

            GenerateSlotsForDay(daySchedule);
            WeekDays.Add(daySchedule);
        }

        BuildHourLabels();
    }

    private void BuildHourLabels()
    {
        Hours.Clear();
        var firstEnabledDay = EditModel.Availability.FirstOrDefault(x => x.IsEnabled);

        if (firstEnabledDay is null || firstEnabledDay.EndTimeSpan <= firstEnabledDay.StartTimeSpan)
        {
            Hours.Add("08:00");
            Hours.Add("09:00");
            Hours.Add("10:00");
            return;
        }

        var startTime = firstEnabledDay.StartTimeSpan;
        var endTime = firstEnabledDay.EndTimeSpan;
        for (var time = startTime; time < endTime; time = time.Add(TimeSpan.FromHours(1)))
        {
            Hours.Add($"{time.Hours:00}:00");
        }
    }

    private void GenerateSlotsForDay(DayScheduleModel day)
    {
        day.Slots.Clear();
        var dayConfig = EditModel.Availability.First(x => x.DayOfWeek == day.DayOfWeek);

        var startTime = dayConfig.StartTimeSpan;
        var endTime = dayConfig.EndTimeSpan;

        if (startTime == TimeSpan.Zero && endTime == TimeSpan.Zero)
        {
            startTime = new(8, 0, 0);
            endTime = new(17, 0, 0);
        }

        if (endTime <= startTime)
        {
            return;
        }

        var interval = Math.Clamp(EditModel.IntervalMinutes, 5, 60);
        for (var time = startTime; time < endTime; time = time.Add(TimeSpan.FromMinutes(interval)))
        {
            var end = time.Add(TimeSpan.FromMinutes(interval));
            var startTimeStr = $"{time.Hours:00}:{time.Minutes:00}:00";
            var endTimeStr = $"{end.Hours:00}:{end.Minutes:00}:00";
            var dbSlot = EditModel.Slots.FirstOrDefault(
                s => s.DayOfWeek == day.DayOfWeek && s.StartTime == startTimeStr && s.EndTime == endTimeStr);

            day.Slots.Add(new TimeSlotModel
            {
                StartTime = $"{time.Hours:00}:{time.Minutes:00}",
                IsActive = dbSlot is not null && !dbSlot.IsDeleted,
                IsDeletedInDb = dbSlot?.IsDeleted ?? false
            });
        }
    }

    private static bool TryParseTime(string value, out TimeSpan result) => TimeSpan.TryParse(value, out result);

    private IEnumerable<TimeSlotModel> GetSlotsForHour(DayScheduleModel day, string hour)
    {
        return day.Slots.Where(slot => slot.StartTime.StartsWith(hour[..2], StringComparison.Ordinal));
    }

    private void ToggleDay(string dayName)
    {
        var day = WeekDays.First(x => x.DayName == dayName);
        day.IsBlocked = !day.IsBlocked;

        var dayConfig = EditModel.Availability.First(x => x.DayOfWeek == day.DayOfWeek);
        dayConfig.IsEnabled = !day.IsBlocked;
    }


    private void ToggleSlot(DayScheduleModel day, TimeSlotModel slot)
    {
        slot.IsActive = !slot.IsActive;

        var dayConfig = EditModel.Availability.First(x => x.DayOfWeek == day.DayOfWeek);
        var activeSlots = day.Slots.Where(s => s.IsActive).OrderBy(s => s.StartTime).ToList();

        if (activeSlots.Count == 0)
        {
            day.IsBlocked = true;
            dayConfig.IsEnabled = false;
            return;
        }

        day.IsBlocked = false;
        dayConfig.IsEnabled = true;

        if (TimeSpan.TryParse(activeSlots.First().StartTime, out var start))
            dayConfig.StartTimeSpan = start;

        if (TimeSpan.TryParse(activeSlots.Last().StartTime, out var lastStart))
            dayConfig.EndTimeSpan = lastStart.Add(TimeSpan.FromMinutes(Math.Clamp(EditModel.IntervalMinutes, 5, 60)));
    }

    private void SyncAvailabilityFromGrid()
    {
        foreach (var day in WeekDays)
        {
            var dayConfig = EditModel.Availability.First(x => x.DayOfWeek == day.DayOfWeek);
            var activeSlots = day.Slots.Where(s => s.IsActive).OrderBy(s => s.StartTime).ToList();

            if (day.IsBlocked || activeSlots.Count == 0)
            {
                dayConfig.IsEnabled = false;
                continue;
            }

            dayConfig.IsEnabled = true;

            if (TimeSpan.TryParse(activeSlots.First().StartTime, out var start))
                dayConfig.StartTimeSpan = start;

            if (TimeSpan.TryParse(activeSlots.Last().StartTime, out var lastStart))
                dayConfig.EndTimeSpan = lastStart.Add(TimeSpan.FromMinutes(Math.Clamp(EditModel.IntervalMinutes, 5, 60)));
        }
    }
    private async Task HandleValidSubmit()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(EditModel.DoctorId))
            {
                FeedbackMessage = "Selecciona un especialista para guardar.";
                IsErrorFeedback = true;
                return;
            }

            IsSaving = true;
            FeedbackMessage = null;

            CollectActiveSlotsFromGrid();

            if (EditModel.ActiveSlots == null || EditModel.ActiveSlots.Count == 0)
            {
                FeedbackMessage = "Debes seleccionar al menos una franja horaria disponible.";
                IsErrorFeedback = true;
                IsSaving = false;
                return;
            }

            var saveResult = await ScheduleConfigService.SaveAsync(ToScheduleConfigModel(EditModel));
            if (saveResult.IsSuccess && saveResult.Value)
            {
                FeedbackMessage = "Configuración guardada correctamente.";
                IsErrorFeedback = false;
                await LoadSelectedSpecialistConfigAsync();
            }
            else
            {
                FeedbackMessage = saveResult.Error?.Message ?? "No se pudo guardar la configuración. Intenta nuevamente.";
                IsErrorFeedback = true;
            }

            IsSaving = false;
        }
        catch (Exception ex)
        {
            FeedbackMessage = $"Error al guardar: {ex.Message}";
            IsErrorFeedback = true;
            IsSaving = false;
        }
    }

    private async Task CancelChanges()
    {
        FeedbackMessage = null;
        await LoadSelectedSpecialistConfigAsync();
    }

    private void CollectActiveSlotsFromGrid()
    {
        var interval = TimeSpan.FromMinutes(Math.Clamp(EditModel.IntervalMinutes, 5, 60));
        EditModel.ActiveSlots = WeekDays
            .Where(d => !d.IsBlocked)
            .SelectMany(d => d.Slots
                .Where(s => s.IsActive)
                .Select(s =>
                {
                    TimeSpan.TryParse(s.StartTime, out var start);
                    var end = start.Add(interval);
                    return new SlotItem
                    {
                        DayOfWeek = d.DayOfWeek,
                        StartTime = $"{start.Hours:00}:{start.Minutes:00}:00",
                        EndTime = $"{end.Hours:00}:{end.Minutes:00}:00"
                    };
                }))
            .ToList();
    }

    private static int DetectIntervalFromSlots(ScheduleConfigModel config)
        => ScheduleConfigHelper.DetectInterval(config);

    private static ScheduleConfigEditModel ToEditModel(ScheduleConfigModel model) => new()
    {
        DoctorId = model.DoctorId,
        BookingWindowWeeks = model.BookingWindowWeeks,
        IntervalMinutes = model.IntervalMinutes,
        Availability = (model.Availability ?? [])
            .Select(day => new AvailabilityDayModel
            {
                DayOfWeek = day.DayOfWeek,
                IsEnabled = day.IsEnabled,
                StartTime = day.StartTime,
                EndTime = day.EndTime
            })
            .ToList(),
        Slots = (model.Slots ?? [])
            .Select(s => new RawSlotInfo
            {
                DayOfWeek = s.DayOfWeek,
                StartTime = s.StartTime,
                EndTime = s.EndTime,
                IsDeleted = s.IsDeleted
            })
            .ToList()
    };

    private static ScheduleConfigModel ToScheduleConfigModel(ScheduleConfigEditModel model) => new()
    {
        DoctorId = model.DoctorId,
        WeekWindowInWeeks = model.WeekWindowInWeeks,
        IntervalMinutes = model.IntervalMinutes,
        ActiveSlots = model.ActiveSlots
    };

    public class DaySchedule
    {
        public string DayName { get; set; } = "";
        public int DayNumber { get; set; }
        public bool IsBlocked { get; set; }
        public List<TimeSlot> Slots { get; set; } = new();
    }

    public class TimeSlot
    {
        public string StartTime { get; set; } = "";
        public bool IsActive { get; set; }
    }
}

