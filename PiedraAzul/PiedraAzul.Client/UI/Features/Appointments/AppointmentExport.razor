@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.States
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Contracts.Enums
@inject UserState UserState
@inject IJSRuntime JS
@inject GraphQLDoctorService DoctorService
@inject GraphQLAppointmentService AppointmentService

<div>
    <!-- Header -->
    <div class="portal-head">
        <h2 class="portal-title">Exportar citas (XLS)</h2>
        <p class="portal-subtitle">Prepare su consulta offline descargando el listado del día.</p>
    </div>

    <!-- Filters -->
    <div class="portal-card mb-5">
        <div class="mb-4 flex items-center gap-2 text-[#257D8D]">
            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span class="text-sm font-bold text-[#0F172A]">Filtros de Exportación</span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
                <label class="portal-card-title mb-2 block uppercase tracking-wider text-xs text-[#94A3B8]">Médico / Terapista</label>
                @if (IsDoctor && !IsAdmin)
                {
                    <div class="doctor-info-row">
                        <svg class="icon-4 flex-shrink-0 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        <span class="text-sm font-medium text-[#0F172A]">@UserState.User?.Name</span>
                        <span class="ml-auto rounded-full bg-[#E0F7FA] px-2 py-0.5 text-xs font-semibold text-[#257D8D]">Tú</span>
                    </div>
                }
                else
                {
                    <select value="@SelectedDoctor" @onchange="OnDoctorChanged" class="search-input rounded-xl">
                        <option value="all">Todos los profesionales</option>
                        @foreach (var doc in allDoctors)
                        {
                            <option value="@doc.DoctorId">@doc.Name (@doc.Specialty)</option>
                        }
                    </select>
                }
            </div>
            <div>
                <label class="portal-card-title mb-2 block uppercase tracking-wider text-xs text-[#94A3B8]">Fecha de Citas</label>
                <input type="date" value="@SelectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged"
                       class="search-input rounded-xl" />
            </div>
        </div>
    </div>

    <!-- Preview -->
    <div class="table-card mb-5">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] bg-[#F8FAFC] px-6 py-4">
            <span class="text-sm font-bold text-[#0F172A]">Vista Previa de Exportación</span>
            <span class="rounded-full bg-[#E0F7FA] px-3 py-1 text-[11px] font-bold text-[#257D8D]">
                @appointments.Count citas encontradas
            </span>
        </div>

        <div class="table-scroll">
            <table class="table-base">
                <thead>
                    <tr class="table-head-row">
                        <th class="table-th">Paciente</th>
                        <th class="table-th">Horario</th>
                        <th class="table-th">Especialidad</th>
                        <th class="table-th">Estado</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    @if (isLoading)
                    {
                        <tr><td colspan="4" class="table-loading"><div class="inline-block"><div class="spinner"></div></div></td></tr>
                    }
                    else if (_lastError is not null)
                    {
                        <tr><td colspan="4" class="py-8 text-center text-xs italic text-rose-500">Error: @_lastError</td></tr>
                    }
                    else if (!appointments.Any())
                    {
                        <tr><td colspan="4" class="table-empty">No se encontraron citas para los filtros seleccionados.</td></tr>
                    }
                    else
                    {
                        @foreach (var app in appointments)
                        {
                            <tr class="table-row">
                                <td class="table-td font-medium text-[#0F172A]">@app.Patient</td>
                                <td class="table-td font-mono text-sm text-[#64748B]">@app.Time</td>
                                <td class="table-td text-sm text-[#64748B]">@app.Specialty</td>
                                <td class="table-td">
                                    <span class="badge-registered">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                        @app.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Actions -->
    <div class="actions-end-row">
        <button @onclick="PrintList" class="btn-portal-outline rounded-xl px-5 py-2.5">
            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            Imprimir Listado
        </button>
        <button @onclick="ExportToExcel" class="btn-portal-sm rounded-xl px-5 py-2.5 text-sm">
            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Exportar datos
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigateTo { get; set; }

    private string SelectedDoctor { get; set; } = "all";
    private DateTime SelectedDate { get; set; } = DateTime.Today;
    private bool isLoading = true;
    private string? _lastError;

    private List<DoctorGQL> allDoctors = new();
    private List<AppointmentVM> appointments = new();

    private bool IsAdmin  => UserState?.User?.Roles.Contains("Admin")  == true;
    private bool IsDoctor => UserState?.User?.Roles.Contains("Doctor") == true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        if (IsDoctor && !IsAdmin)
        {
            SelectedDoctor = UserState.User!.Id;
        }
        else
        {
            for (int i = 0; i <= 3; i++)
            {
                var result = await DoctorService.GetDoctorsByTypeAsync(((DoctorType)i).ToGraphQL());
                if (result.Any()) allDoctors.AddRange(result);
            }
        }

        await LoadAppointmentsAsync();
    }

    private async Task OnDoctorChanged(ChangeEventArgs e)
    {
        SelectedDoctor = e.Value?.ToString() ?? "all";
        await LoadAppointmentsAsync();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            SelectedDate = date;
            await LoadAppointmentsAsync();
        }
    }

    private async Task LoadAppointmentsAsync()
    {
        isLoading = true; _lastError = null;
        var list = new List<AppointmentVM>();

        if (SelectedDoctor == "all")
        {
            foreach (var doc in allDoctors)
            {
                var res = await AppointmentService.GetDoctorAppointments(doc.DoctorId, SelectedDate);
                if (res.IsSuccess)
                    list.AddRange(res.Value.Select(a => Map(a, doc.Specialty)));
                else
                    _lastError = $"[{doc.Name}] {res.Error?.Message}";
            }
        }
        else
        {
            var doc = allDoctors.FirstOrDefault(d => d.DoctorId == SelectedDoctor);
            var res = await AppointmentService.GetDoctorAppointments(SelectedDoctor, SelectedDate);
            if (res.IsSuccess)
                list.AddRange(res.Value.Select(a => Map(a, doc?.Specialty ?? "General")));
            else
                _lastError = res.Error?.Message;
        }

        appointments = list.OrderBy(a => a.Time).ToList();
        isLoading = false;
        StateHasChanged();
    }

    private static AppointmentVM Map(AppointmentGQL a, string specialty) => new()
    {
        Patient   = string.IsNullOrWhiteSpace(a.PatientName) ? "Paciente" : a.PatientName,
        Time      = a.Start.ToLocalTime().ToString("hh:mm tt"),
        Specialty = specialty,
        Status    = a.Status switch
        {
            "Active"    => "Pendiente",
            "Completed" => "Completada",
            "NoShow"    => "No Asistió",
            "Cancelled" => "Cancelada",
            _           => a.Status
        }
    };

    private async Task PrintList()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportToExcel()
    {
        if (!appointments.Any()) return;
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Paciente,Hora,Especialidad,Estado");
        foreach (var a in appointments)
            csv.AppendLine($"\"{a.Patient}\",\"{a.Time}\",\"{a.Specialty}\",\"{a.Status}\"");

        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"citas_{SelectedDate:yyyy-MM-dd}.csv";
        await JS.InvokeVoidAsync("eval", $@"
            var a = document.createElement('a');
            a.href = 'data:text/csv;base64,{base64}';
            a.download = '{fileName}';
            a.click();
        ");
    }

    private class AppointmentVM
    {
        public string Patient   { get; set; } = "";
        public string Time      { get; set; } = "";
        public string Specialty { get; set; } = "";
        public string Status    { get; set; } = "";
    }
}
