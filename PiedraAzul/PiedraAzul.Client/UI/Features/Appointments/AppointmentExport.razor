@using System.Globalization
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.States
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.UI.Shared.Components
@using PiedraAzul.Contracts.Enums
@inject UserState UserState
@inject IJSRuntime JS
@inject GraphQLDoctorService DoctorService
@inject GraphQLAppointmentService AppointmentService

<div>
    <!-- Header -->
    <div class="portal-head">
        <h2 class="portal-title">Exportar citas (XLS)</h2>
        <p class="portal-subtitle">Prepare su consulta offline descargando el listado por rango de fechas.</p>
    </div>

    <!-- Filtros -->
    <div class="portal-card mb-5">
        <div class="mb-4 flex items-center gap-2 text-[#257D8D]">
            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span class="text-sm font-bold text-[#0F172A]">Filtros de Exportación</span>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_340px]">

            <!-- Columna izquierda: especialista + resumen + acciones -->
            <div class="flex flex-col gap-4">
                <div>
                    <label class="portal-card-title mb-2 block text-xs uppercase tracking-wider text-[#94A3B8]">Médico / Terapista</label>
                    <DoctorAutocomplete Doctors="allDoctors"
                                        Value="SelectedDoctor"
                                        ValueChanged="OnDoctorChanged"
                                        ValueSelector="d => d.DoctorId"
                                        IncludeAll="true"
                                        AllValue="all"
                                        AllLabel="Todos los profesionales"
                                        Placeholder="Busca por nombre o especialidad..." />
                </div>

                <!-- Resumen -->
                <div class="rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] p-4">
                    <p class="portal-card-title mb-3 text-xs uppercase tracking-wider text-[#94A3B8]">Resumen</p>
                    <div class="space-y-2 text-sm">
                        <div class="flex items-center justify-between">
                            <span class="text-[#64748B]">Profesional</span>
                            <span class="font-semibold text-[#0F172A]">@DoctorLabel</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-[#64748B]">Rango</span>
                            <span class="font-semibold text-[#0F172A]">@RangeLabel</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-[#64748B]">Citas encontradas</span>
                            <span class="rounded-full bg-[#E0F7FA] px-2.5 py-0.5 text-xs font-bold text-[#257D8D]">@appointments.Count</span>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-col gap-2">
                        <button @onclick="ExportToExcel" disabled="@(!appointments.Any())" class="btn-portal-sm w-full rounded-xl px-4 py-2.5 text-sm disabled:opacity-50">
                            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Exportar a Excel
                        </button>
                        <button @onclick="PrintList" disabled="@(!appointments.Any())" class="btn-portal-outline w-full rounded-xl px-4 py-2.5 disabled:opacity-50">
                            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
                            Imprimir listado de asistencia
                        </button>
                    </div>
                </div>
            </div>

            <!-- Columna derecha: calendario de rango -->
            <div>
                <label class="portal-card-title mb-2 block text-xs uppercase tracking-wider text-[#94A3B8]">Rango de fechas</label>
                <div class="rounded-xl border border-[#E2E8F0] bg-white p-3 shadow-sm">
                    <div class="mb-2 flex items-center justify-between px-1">
                        <button @onclick="PrevMonth" class="cal-nav-btn">
                            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <span class="text-sm font-black text-[#0F172A]">@CalMonthLabel</span>
                        <button @onclick="NextMonth" class="cal-nav-btn">
                            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                    <div class="rcal-grid mb-1">
                        @foreach (var d in new[] { "L", "M", "X", "J", "V", "S", "D" })
                        {
                            <div class="py-1 text-center text-[10px] font-bold uppercase text-[#94A3B8]">@d</div>
                        }
                    </div>
                    <div class="rcal-grid">
                        @foreach (var date in CalDays)
                        {
                            var inMonth = date.Month == CalMonth.Month;
                            <div class="rcal-cell @CellClass(date, inMonth)" @onclick="() => OnDayClick(date)">
                                @date.Day
                            </div>
                        }
                    </div>
                    <p class="mt-2 px-1 text-[10px] italic text-[#94A3B8]">
                        Un clic = un día. Dos clics = rango (el orden no importa).
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Vista previa -->
    <div class="table-card">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] bg-[#F8FAFC] px-6 py-4">
            <span class="text-sm font-bold text-[#0F172A]">Vista previa</span>
            <span class="rounded-full bg-[#E0F7FA] px-3 py-1 text-[11px] font-bold text-[#257D8D]">
                @appointments.Count citas
            </span>
        </div>

        <div class="table-scroll">
            <table class="table-base">
                <thead>
                    <tr class="table-head-row">
                        <th class="table-th">Paciente</th>
                        <th class="table-th">Fecha</th>
                        <th class="table-th">Horario</th>
                        <th class="table-th">Especialidad</th>
                        <th class="table-th">Estado</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    @if (isLoading)
                    {
                        <tr><td colspan="5" class="table-loading"><div class="inline-block"><div class="spinner"></div></div></td></tr>
                    }
                    else if (_lastError is not null)
                    {
                        <tr><td colspan="5" class="py-8 text-center text-xs italic text-rose-500">Error: @_lastError</td></tr>
                    }
                    else if (!appointments.Any())
                    {
                        <tr><td colspan="5" class="table-empty">No se encontraron citas para los filtros seleccionados.</td></tr>
                    }
                    else
                    {
                        @foreach (var app in appointments)
                        {
                            <tr class="table-row">
                                <td class="table-td font-medium text-[#0F172A]">@app.Patient</td>
                                <td class="table-td text-sm text-[#64748B]">@app.DateLabel</td>
                                <td class="table-td font-mono text-sm text-[#64748B]">@app.Time</td>
                                <td class="table-td text-sm text-[#64748B]">@app.Specialty</td>
                                <td class="table-td">
                                    <span class="badge-registered">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                        @app.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigateTo { get; set; }

    private static readonly CultureInfo _es = new("es-ES");

    private string? SelectedDoctor { get; set; } = "all";
    private bool isLoading = true;
    private string? _lastError;

    private List<DoctorGQL> allDoctors = new();
    private List<AppointmentVM> appointments = new();

    // Rango de fechas
    private DateTime RangeStart = DateTime.Today;
    private DateTime RangeEnd = DateTime.Today;
    private DateTime _anchor = DateTime.Today;
    private bool _awaitingEnd;

    // Calendario visible
    private DateTime CalMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<DateTime> CalDays = new();

    private string CalMonthLabel =>
        char.ToUpper(CalMonth.ToString("MMMM", _es)[0]) + CalMonth.ToString("MMMM yyyy", _es)[1..];

    private string RangeLabel =>
        RangeStart.Date == RangeEnd.Date
            ? RangeStart.ToString("d MMM yyyy", _es)
            : $"{RangeStart.ToString("d MMM", _es)} – {RangeEnd.ToString("d MMM yyyy", _es)}";

    private string DoctorLabel =>
        (SelectedDoctor is null or "all")
            ? "Todos"
            : allDoctors.FirstOrDefault(d => d.DoctorId == SelectedDoctor)?.Name ?? "—";

    protected override async Task OnInitializedAsync()
    {
        BuildCalendar();
        isLoading = true;

        for (int i = 0; i <= 3; i++)
        {
            var result = await DoctorService.GetDoctorsByTypeAsync(((DoctorType)i).ToGraphQL());
            if (result.Any()) allDoctors.AddRange(result);
        }

        await LoadAppointmentsAsync();
    }

    private void BuildCalendar()
    {
        CalDays.Clear();
        var first = new DateTime(CalMonth.Year, CalMonth.Month, 1);
        int offset = ((int)first.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        var start = first.AddDays(-offset);
        for (int i = 0; i < 42; i++) CalDays.Add(start.AddDays(i));
    }

    private void PrevMonth() { CalMonth = CalMonth.AddMonths(-1); BuildCalendar(); }
    private void NextMonth() { CalMonth = CalMonth.AddMonths(1); BuildCalendar(); }

    private async Task OnDayClick(DateTime date)
    {
        if (!_awaitingEnd)
        {
            // Primer clic: un día específico
            _anchor = date.Date;
            RangeStart = date.Date;
            RangeEnd = date.Date;
            _awaitingEnd = true;
        }
        else
        {
            // Segundo clic: cerrar rango (bidireccional)
            RangeStart = date.Date <= _anchor ? date.Date : _anchor;
            RangeEnd   = date.Date >= _anchor ? date.Date : _anchor;
            _awaitingEnd = false;
        }
        await LoadAppointmentsAsync();
    }

    private string CellClass(DateTime date, bool inMonth)
    {
        if (!inMonth) return "rcal-muted";

        var d = date.Date;
        if (RangeStart.Date == RangeEnd.Date && d == RangeStart.Date) return "rcal-single";
        if (d == RangeStart.Date) return "rcal-start";
        if (d == RangeEnd.Date)   return "rcal-end";
        if (d > RangeStart.Date && d < RangeEnd.Date) return "rcal-inrange";
        if (d == DateTime.Today) return "rcal-today";
        return "";
    }

    private async Task OnDoctorChanged(string? value)
    {
        SelectedDoctor = value ?? "all";
        await LoadAppointmentsAsync();
    }

    private async Task LoadAppointmentsAsync()
    {
        isLoading = true; _lastError = null; StateHasChanged();
        var list = new List<AppointmentVM>();

        // Doctores a consultar
        var targets = (SelectedDoctor is null or "all")
            ? allDoctors
            : allDoctors.Where(d => d.DoctorId == SelectedDoctor).ToList();

        foreach (var doc in targets)
        {
            // Traemos TODAS las citas del doctor una vez y filtramos por rango en cliente.
            var res = await AppointmentService.GetDoctorAppointments(doc.DoctorId, null);
            if (res.IsSuccess)
            {
                var inRange = (res.Value ?? new())
                    .Where(a => a.Start.Date >= RangeStart.Date && a.Start.Date <= RangeEnd.Date)
                    .Select(a => Map(a, doc.Specialty));
                list.AddRange(inRange);
            }
            else
            {
                _lastError = $"[{doc.Name}] {res.Error?.Message}";
            }
        }

        appointments = list.OrderBy(a => a.SortKey).ToList();
        isLoading = false;
        StateHasChanged();
    }

    private static AppointmentVM Map(AppointmentGQL a, string specialty) => new()
    {
        SortKey   = a.Start,
        Patient   = string.IsNullOrWhiteSpace(a.PatientName) ? "Paciente" : a.PatientName,
        DateLabel = a.Start.ToString("dd/MM/yyyy"),
        Time      = a.Start.ToString("hh:mm tt"),
        Specialty = specialty,
        Status    = a.Status switch
        {
            "Active"    => "Pendiente",
            "Completed" => "Completada",
            "NoShow"    => "No Asistió",
            "Cancelled" => "Cancelada",
            _           => a.Status
        }
    };

    private string DoctorFull =>
        (SelectedDoctor is null or "all")
            ? "Todos los profesionales"
            : allDoctors.FirstOrDefault(d => d.DoctorId == SelectedDoctor) is { } d ? $"{d.Name} ({d.Specialty})" : "—";

    /// <summary>
    /// Construye la tabla "registro" compartida por impresión y XLS:
    /// fila de título, fila de especialista, encabezados y filas de datos.
    /// La columna Asistencia queda vacía (casilla ☐ en impresión) para marcar a mano.
    /// </summary>
    private string BuildRegistryTable(bool forPrint)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<table><colgroup>");
        sb.Append("<col style='width:200px'><col style='width:90px'><col style='width:90px'><col style='width:150px'><col style='width:110px'><col style='width:90px'>");
        sb.Append("</colgroup>");
        sb.Append($"<tr><td colspan='6' class='title'>Registro Piedra Azul — {Esc(RangeLabel)}</td></tr>");
        sb.Append($"<tr><td colspan='6' class='specialist'>Especialista: {Esc(DoctorFull)}</td></tr>");
        sb.Append("<tr>"
            + "<td class='hc'>Paciente</td><td class='hc'>Fecha</td><td class='hc'>Horario</td>"
            + "<td class='hc'>Especialidad</td><td class='hc'>Estado</td><td class='hc'>Asistencia</td></tr>");
        foreach (var a in appointments)
        {
            var asistencia = forPrint ? "<span class='chk'></span>" : "";
            sb.Append($"<tr><td>{Esc(a.Patient)}</td><td class='c'>{Esc(a.DateLabel)}</td><td class='c'>{Esc(a.Time)}</td><td class='c'>{Esc(a.Specialty)}</td><td class='c'>{Esc(a.Status)}</td><td class='c'>{asistencia}</td></tr>");
        }
        sb.Append("</table>");
        return sb.ToString();
    }

    private async Task PrintList()
    {
        if (!appointments.Any()) return;

        const string styles = @"
            *{box-sizing:border-box;}
            body{font-family:Arial,'DM Sans',sans-serif;color:#0F172A;margin:24px;}
            table{border-collapse:collapse;width:100%;table-layout:fixed;}
            td{border:1px solid #334155;padding:9px 8px;font-size:11px;word-wrap:break-word;}
            .title{font-weight:bold;text-align:center;font-size:16px;background:#257D8D;color:#fff;border-color:#257D8D;}
            .specialist{font-weight:bold;text-align:left;background:#e8f5f3;}
            .hc{font-weight:bold;text-align:center;background:#f1f5f9;text-transform:uppercase;font-size:10px;letter-spacing:.04em;}
            .c{text-align:center;}
            .chk{display:inline-block;width:16px;height:16px;border:1.5px solid #475569;border-radius:3px;}
            @media print{@page{size:A4;margin:14mm;}body{margin:0;}*{-webkit-print-color-adjust:exact;print-color-adjust:exact;}}
        ";

        var html = $"<!DOCTYPE html><html lang='es'><head><meta charset='utf-8'><title>Registro Piedra Azul</title><style>{styles}</style></head><body>{BuildRegistryTable(true)}</body></html>";
        await JS.InvokeVoidAsync("printHtml", html);
    }

    private async Task ExportToExcel()
    {
        if (!appointments.Any()) return;

        // .xls real: HTML con namespaces de Office que Excel/Sheets/Numbers abren nativamente.
        const string styles = @"
            table{border-collapse:collapse;width:100%;font-family:Arial,sans-serif;table-layout:fixed;}
            td{border:1px solid #000;padding:10px 8px;font-size:10pt;word-wrap:break-word;vertical-align:middle;}
            .title{font-weight:bold;text-align:center;font-size:14pt;background-color:#257D8D;color:#ffffff;}
            .specialist{font-weight:bold;text-align:left;background-color:#e8f5f3;}
            .hc{font-weight:bold;text-align:center;background-color:#f1f5f9;}
            .c{text-align:center;}
        ";

        var html = $"<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:x='urn:schemas-microsoft-com:office:excel' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><style>{styles}</style></head><body>{BuildRegistryTable(false)}</body></html>";

        var bytes = System.Text.Encoding.UTF8.GetBytes(html);
        var base64 = Convert.ToBase64String(bytes);
        var fileName = RangeStart.Date == RangeEnd.Date
            ? $"Listado_Citas_{RangeStart:yyyyMMdd}.xls"
            : $"Listado_Citas_{RangeStart:yyyyMMdd}_{RangeEnd:yyyyMMdd}.xls";

        await JS.InvokeVoidAsync("downloadFile", fileName, "application/vnd.ms-excel;base64," + base64);
    }

    private static string Esc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    private class AppointmentVM
    {
        public DateTime SortKey   { get; set; }
        public string Patient     { get; set; } = "";
        public string DateLabel   { get; set; } = "";
        public string Time        { get; set; } = "";
        public string Specialty   { get; set; } = "";
        public string Status      { get; set; } = "";
    }
}
