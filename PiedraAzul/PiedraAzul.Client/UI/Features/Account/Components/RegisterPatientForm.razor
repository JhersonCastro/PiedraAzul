<h3>RegisterPatientForm</h3>

<div class="form-shell-wide">

    <!-- HEADER -->
    <div>
        <h1 class="page-heading">Crear cuenta</h1>
        <p class="page-subheading">
            Complete la siguiente información para registrarse
        </p>
    </div>

    <!-- ===================== -->
    <!-- DATOS PERSONALES -->
    <!-- ===================== -->
    <div class="form-section">
        <div>
            <h2 class="section-heading">Datos personales</h2>
            <p class="section-subtext">
                Por favor ingrese su información básica para continuar.
            </p>
        </div>

        <div class="form-grid">

            <!-- Documento -->
            <div>
                <label class="label-lg">
                    Número de documento
                </label>
                <p class="form-hint">
                    Ejemplo: cédula de ciudadanía
                </p>

                <input type="text"
                       placeholder="Ingrese su documento"
                       class="input-lg">
            </div>

            <!-- Nombre -->
            <div>
                <label class="label-lg">
                    Nombre completo
                </label>
                <p class="form-hint">
                    Tal como aparece en su documento
                </p>

                <input type="text"
                       placeholder="Ej: Juan Pérez"
                       class="input-lg">
            </div>

            <!-- Teléfono -->
            <div>
                <label class="label-lg">
                    Número de teléfono
                </label>
                <p class="form-hint">
                    Para contactarlo sobre su cita
                </p>

                <input type="text"
                       placeholder="Ej: 301 123 4567"
                       class="input-lg">
            </div>

            <!-- Género -->
            <div>
                <label class="label-lg">
                    Género
                </label>
                <p class="form-hint">
                    Seleccione una opción
                </p>

                <select class="input-lg">
                    <option>Seleccione género</option>
                    <option>Hombre</option>
                    <option>Mujer</option>
                    <option>Otro</option>
                </select>
            </div>

        </div>
    </div>

    <!-- ===================== -->
    <!-- INFORMACIÓN ADICIONAL -->
    <!-- ===================== -->
    <div class="form-section">
        <div>
            <h2 class="section-heading">Información adicional</h2>
            <p class="section-subtext">
                Estos datos nos ayudan a brindarle un mejor servicio (opcional).
            </p>
        </div>

        <div class="form-grid">

            <!-- Fecha -->
            <div>
                <label class="label-lg">
                    Fecha de nacimiento
                </label>
                <p class="form-hint">
                    Nos ayuda a personalizar su atención
                </p>

                <input type="date"
                       class="input-lg">
            </div>

            <!-- Email -->
            <div>
                <label class="label-lg">
                    Correo electrónico
                </label>
                <p class="form-hint">
                    Para enviarle confirmaciones (opcional)
                </p>

                <input type="email"
                       placeholder="ejemplo@gmail.com"
                       class="input-lg">
            </div>

        </div>
    </div>

    <!-- ===================== -->
    <!-- SEGURIDAD -->
    <!-- ===================== -->
    <div class="form-section">
        <div>
            <h2 class="section-heading">Seguridad</h2>
            <p class="section-subtext">
                Cree una contraseña para acceder a su cuenta.
            </p>
        </div>

        <div class="form-grid">

            <!-- Password -->
            <div>
                <label class="label-lg">
                    Contraseña
                </label>
                <p class="form-hint">
                    Mínimo 6 caracteres
                </p>

                <input type="password"
                       placeholder="Ingrese su contraseña"
                       class="input-lg">
            </div>

            <!-- Confirm -->
            <div>
                <label class="label-lg">
                    Confirmar contraseña
                </label>
                <p class="form-hint">
                    Repita la contraseña anterior
                </p>

                <input type="password"
                       placeholder="Repita su contraseña"
                       class="input-lg">
            </div>

        </div>
    </div>

    <!-- ===================== -->
    <!-- ACCIONES -->
    <!-- ===================== -->
    <div class="form-actions">

        <button class="btn-primary-lg">
            Crear cuenta
        </button>

        <button class="btn-secondary-lg">
            ¿Ya tiene una cuenta? Inicie sesión
        </button>

    </div>

</div>

