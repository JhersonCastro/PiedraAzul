@using PiedraAzul.Client.Models
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Models.UserProfiles
@using PiedraAzul.Client.Services.AuthServices
@using PiedraAzul.Client.States
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthService
@inject PasskeyService PasskeyService
@inject UserState UserState
@inject IJSRuntime JS

@if (_mfaRequired is not null)
{
    <MFAVerification MFARequired="@_mfaRequired" OnBack="HandleBackFromMFA" OnVerified="HandleMFAVerified" />
}
else
{
    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="auth-narrow">
        <DataAnnotationsValidator />
        <div class="form-card">

            <!-- Header -->
            <h2 class="auth-heading">
                Ingresa a tu cuenta
            </h2>

            <p class="auth-subheading">
                Accede a tus servicios médicos de forma segura.
            </p>

            <!-- Validation -->
            <ValidationSummary class="form-error-summary" />

            <!-- Usuario -->
            <div class="field">
                <label class="label">
                    Identificación, teléfono o correo
                </label>

                <InputText @bind-Value="loginModel.Login"
                           class="input"
                           placeholder="Ej: 101234567 o correo@email.com" />
            </div>

            <!-- Contraseña -->
            <div class="field">
                <label class="label">
                    Contraseña
                </label>
                <InputText @bind-Value="loginModel.Password"
                           type="password"
                           class="input"
                           placeholder="Tu contraseña" />
            </div>

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="form-error">@_errorMessage</p>
            }

            <!-- Acciones -->
            <div class="auth-actions">

                <button type="submit"
                        disabled="@_loading"
                        class="btn-primary">
                    @(_loading ? "Iniciando sesión..." : "Iniciar sesión")
                </button>

                @if (_passkeySupported)
                {
                    <button type="button"
                            @onclick="HandlePasskeyLogin"
                            disabled="@_passkeyLoading"
                            class="btn-ghost btn-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon-passkey" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 1a5 5 0 1 0 5 5 5 5 0 0 0-5-5zm0 8a3 3 0 1 1 3-3 3 3 0 0 1-3 3zm-1 2h2v2.18A7 7 0 0 1 19 20H5a7 7 0 0 1 6-6.82V11z"/>
                        </svg>
                        @(_passkeyLoading ? "Verificando..." : "Ingresar con passkey")
                    </button>
                }

                <button type="button"
                        @onclick="async () => await OnRegisterClick.InvokeAsync()"
                        class="btn-secondary">
                    ¿No tienes cuenta? Regístrate
                </button>

            </div>

        </div>
    </EditForm>
}

@code {
    private LoginModel loginModel = new();
    private MFARequired? _mfaRequired;

    [Parameter]
    public EventCallback OnRegisterClick { get; set; }
    [Parameter]
    public string? ReturnUrl { get; set; } = string.Empty;

    private string? _errorMessage;
    private bool _loading;
    private bool _passkeySupported;
    private bool _passkeyLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _passkeySupported = await PasskeyService.IsSupportedAsync();
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (!result.IsSuccess)
            {
                _errorMessage = result.Error?.Message ?? "Ocurrió un error al intentar iniciar sesión.";
                return;
            }

            var loginResult = result.Value;

            // Check if MFA is required
            if (loginResult?.MFARequired is not null)
            {
                _mfaRequired = loginResult.MFARequired;
                StateHasChanged();
                return;
            }

            // Aplicar cookie vía request HTTP directo (funciona en SSR y WASM)
            var token = loginResult?.LoginToken;
            if (string.IsNullOrEmpty(token))
            {
                _errorMessage = "Error al iniciar sesión. Intenta de nuevo.";
                return;
            }

            var destination = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
            var encoded = Uri.EscapeDataString(destination);
            NavigationManager.NavigateTo($"/auth/apply-session?token={token}&redirect={encoded}", forceLoad: true);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleBackFromMFA()
    {
        _mfaRequired = null;
        loginModel.Password = string.Empty;
        StateHasChanged();
    }

    private Task HandleMFAVerified(UserGQL? user)
    {
        // La redirección ocurre dentro de MFAVerification vía apply-session
        return Task.CompletedTask;
    }

    private async Task HandlePasskeyLogin()
    {
        _passkeyLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await PasskeyService.LoginAsync();

            if (!result.IsSuccess)
            {
                _errorMessage = result.Error?.Message ?? "No se pudo verificar la passkey. Intenta de nuevo.";
                return;
            }

            var passkeyResult = result.Value;
            var token = passkeyResult?.LoginToken;
            if (string.IsNullOrEmpty(token))
            {
                _errorMessage = "No se pudo verificar la passkey. Intenta de nuevo.";
                return;
            }

            var destination = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
            var encoded = Uri.EscapeDataString(destination);
            NavigationManager.NavigateTo($"/auth/apply-session?token={token}&redirect={encoded}", forceLoad: true);
        }
        catch (Exception ex) when (ex.Message.Contains("cancel", StringComparison.OrdinalIgnoreCase)
                                   || ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = "Cancelaste la autenticación.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _passkeyLoading = false;
            StateHasChanged();
        }
    }
}
