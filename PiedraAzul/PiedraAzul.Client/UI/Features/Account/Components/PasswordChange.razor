@using PiedraAzul.Client.Services.GraphQLServices

<div class="form-stack-sm">
    <div>
        <label class="label-xs">Contraseña actual</label>
        <input type="password" placeholder="••••••••"
               @bind="_current" @bind:event="oninput"
               class="input-field border-gray-300" />
    </div>

    <div>
        <label class="label-xs">Nueva contraseña</label>
        <input type="password" placeholder="••••••••"
               @bind="_next" @bind:event="oninput"
               class="input-field @(_next.Length > 0 && _next.Length < 6 ? "border-yellow-400" : "border-gray-300")" />
        @if (_next.Length > 0 && _next.Length < 6)
        {
            <p class="hint-warn">Mínimo 6 caracteres</p>
        }
    </div>

    <div>
        <label class="label-xs">Confirmar nueva contraseña</label>
        <div class="relative">
            <input type="password" placeholder="••••••••"
                   @bind="_confirm" @bind:event="oninput"
                   class="input-field pr-9 @(Mismatch ? "border-[#E76F51]" : Match ? "border-[#4CAF7D]" : "border-gray-300")" />
            @if (Match)
            {
                <svg class="input-icon-ok"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            }
            else if (Mismatch)
            {
                <svg class="input-icon-err"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            }
        </div>
        @if (Mismatch)
        {
            <p class="hint-danger">Las contraseñas no coinciden</p>
        }
        else if (Match)
        {
            <p class="hint-ok">Las contraseñas coinciden ✓</p>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="notice-error">@_error</div>
    }
    @if (_saved)
    {
        <div class="notice-ok">
            ✓ Contraseña actualizada correctamente.
        </div>
    }

    <div class="actions-end">
        <button @onclick="HandleSubmit" disabled="@_loading"
                class="btn-teal">
            @(_loading ? "Actualizando..." : "Actualizar contraseña")
        </button>
    </div>
</div>

@code {
    [Parameter] public GraphQLHttpClient? GraphQL { get; set; }

    private string _current = "";
    private string _next = "";
    private string _confirm = "";
    private bool _loading;
    private bool _saved;
    private string? _error;

    private bool Match => _next.Length > 0 && _confirm.Length > 0 && _next == _confirm;
    private bool Mismatch => _next.Length > 0 && _confirm.Length > 0 && _next != _confirm;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_next) || string.IsNullOrWhiteSpace(_confirm))
        {
            _error = "Completa todos los campos.";
            return;
        }
        if (_next.Length < 6) { _error = "La nueva contraseña debe tener al menos 6 caracteres."; return; }
        if (_next != _confirm) { _error = "Las contraseñas no coinciden."; return; }

        _loading = true;
        _error = null;
        _saved = false;
        StateHasChanged();

        try
        {
            const string mutation = """
                mutation ChangePassword($input: ChangePasswordInput!) {
                    changePassword(input: $input)
                }
                """;

            var result = await GraphQL!.ExecuteAsync<bool>(
                mutation,
                new { input = new { currentPassword = _current, newPassword = _next } },
                "changePassword");

            if (result)
            {
                _saved = true;
                _current = _next = _confirm = "";
                await Task.Delay(3000);
                _saved = false;
                StateHasChanged();
            }
            else
            {
                _error = "No se pudo actualizar. Verifica tu contraseña actual.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
