@using PiedraAzul.Client.Models.UserProfiles
@using PiedraAzul.Client.Services.AuthServices
@using PiedraAzul.Client.UI.Shared.Components.StepTag
@using PiedraAzul.Contracts.Enums
@using PiedraAzul.Contracts.Validation

@inject AuthenticationService AuthService
@inject NavigationManager NavigationManager

<EditForm Model="@registerModel"  class="flex justify-center">

    <DataAnnotationsValidator />

    <div class="form-shell">

        <Stepper TModel="RegisterModel" FinishText="Crear cuenta" OnFinish="HandleRegister">

            <!-- STEP 1 -->
            <Step TModel="RegisterModel"
                  Title="Datos personales"
                  Fields="@(new[] { nameof(registerModel.DocumentType), nameof(registerModel.Document), nameof(registerModel.FullName), nameof(registerModel.Phone), nameof(registerModel.Gender), nameof(registerModel.BirthDate) })">

                <h2 class="form-heading">Datos personales</h2>
                <p class="form-heading-sub">
                    Por favor ingrese su información básica para continuar.
                </p>

                <div class="form-grid">

                    <!-- Tipo de documento -->
                    <div>
                        <label class="label-lg">
                            Tipo de documento
                        </label>
                        <p class="form-hint">
                            Seleccione el tipo de documento
                        </p>

                        <InputSelect @bind-Value="registerModel.DocumentType"
                                     class="input-lg">
                            <option value="@DocumentType.CC">Cédula de ciudadanía (18+ años)</option>
                            <option value="@DocumentType.TI">Tarjeta de identidad (7–17 años)</option>
                            <option value="@DocumentType.CE">Cédula de extranjería</option>
                            <option value="@DocumentType.PA">Pasaporte</option>
                        </InputSelect>

                        <ValidationMessage For="@(() => registerModel.DocumentType)" class="form-error" />
                    </div>

                    <!-- Documento -->
                    <div>
                        <label class="label-lg">
                            Número de documento
                        </label>
                        <p class="form-hint">
                            @DocumentHint(registerModel.DocumentType)
                        </p>

                        <InputText @bind-Value="registerModel.Document"
                                   class="input-lg"
                                   placeholder="Ingrese su documento" />

                        <ValidationMessage For="@(() => registerModel.Document)" class="form-error" />
                    </div>

                    <!-- Nombre -->
                    <div>
                        <label class="label-lg">
                            Nombre completo
                        </label>
                        <p class="form-hint">
                            Tal como aparece en su documento
                        </p>

                        <InputText @bind-Value="registerModel.FullName"
                                   class="input-lg"
                                   placeholder="Ej: Juan Pérez" />

                        <ValidationMessage For="@(() => registerModel.FullName)" class="form-error" />
                    </div>

                    <!-- Teléfono -->
                    <div>
                        <label class="label-lg">
                            Número de celular
                        </label>
                        <p class="form-hint">
                            Celular colombiano (10 dígitos, empieza por 3)
                        </p>

                        <InputText @bind-Value="registerModel.Phone"
                                   class="input-lg"
                                   placeholder="Ej: 301 123 4567" />

                        <ValidationMessage For="@(() => registerModel.Phone)" class="form-error" />
                    </div>

                    <!-- Género -->
                    <div>
                        <label class="label-lg">
                            Género
                        </label>
                        <p class="form-hint">
                            Seleccione una opción
                        </p>

                        <InputSelect @bind-Value="registerModel.Gender"
                                     class="input-lg">

                            <option value="@GenderType.NonSpecified">Seleccione género</option>
                            <option value="@GenderType.Male">Hombre</option>
                            <option value="@GenderType.Female">Mujer</option>
                            <option value="@GenderType.Other">Otro</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => registerModel.Gender)" class="form-error" />
                    </div>

                    <!-- Fecha de nacimiento -->
                    <div>
                        <label class="label-lg">
                            Fecha de nacimiento
                        </label>
                        <p class="form-hint">
                            Debe ser mayor de 13 años
                        </p>

                        <InputDate @bind-Value="registerModel.BirthDate"
                                   @bind-Value:after="SuggestDocumentType"
                                   class="input-lg" />

                        <ValidationMessage For="@(() => registerModel.BirthDate)" class="form-error" />
                    </div>

                </div>

            </Step>

            <!-- STEP 2 -->
            <Step TModel="RegisterModel"
                  Title="Información adicional"
                  Fields="@(new[] { nameof(registerModel.Email) })">

                <h2 class="form-heading">Información adicional</h2>
                <p class="form-heading-sub">
                    Estos datos nos ayudan a brindarle un mejor servicio (opcional).
                </p>

                <div class="form-grid">

                    <!-- Email -->
                    <div>
                        <label class="label-lg">
                            Correo electrónico
                        </label>
                        <p class="form-hint">
                            Para enviarle confirmaciones (opcional)
                        </p>

                        <InputText @bind-Value="registerModel.Email"
                                   type="email"
                                   class="input-lg"
                                   placeholder="ejemplo@gmail.com" />

                        <ValidationMessage For="@(() => registerModel.Email)" class="form-error" />
                    </div>

                </div>

            </Step>

            <!-- STEP 3 -->
            <Step TModel="RegisterModel"
                  Title="Seguridad"
                  Fields="@(new[] { nameof(registerModel.Password), nameof(registerModel.ConfirmPassword) })">

                <h2 class="form-heading">Crear contraseña</h2>
                <p class="form-heading-sub">
                    Esta contraseña le permitirá acceder a su cuenta.
                </p>

                <div class="form-grid">

                    <!-- Password -->
                    <div>
                        <label class="label-lg">
                            Contraseña
                        </label>
                        <p class="form-hint">
                            Mínimo 6 caracteres
                        </p>

                        <InputText @bind-Value="registerModel.Password"
                                   type="password"
                                   class="input-lg"
                                   placeholder="Ingrese su contraseña" />

                        <ValidationMessage For="@(() => registerModel.Password)" class="form-error" />
                    </div>

                    <!-- Confirm -->
                    <div>
                        <label class="label-lg">
                            Confirmar contraseña
                        </label>
                        <p class="form-hint">
                            Repita la contraseña anterior
                        </p>

                        <InputText @bind-Value="registerModel.ConfirmPassword"
                                   type="password"
                                   class="input-lg"
                                   placeholder="Repita su contraseña" />

                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="form-error" />
                    </div>

                </div>

            </Step>

        </Stepper>

        <!-- Login -->
        <button type="button"
                @onclick="async () => await OnLoginClick.InvokeAsync()"
                class="btn-secondary-lg mt-8">
            ¿Ya tiene una cuenta? Inicie sesión
        </button>
        @* mt-8: separación puntual respecto al Stepper *@

    </div>
</EditForm>

@code {
    private RegisterModel registerModel = new();

    [Parameter]
    public EventCallback OnLoginClick { get; set; }
    private string? _errorMessage;

    private static string DocumentHint(DocumentType type) => type switch
    {
        DocumentType.CC => "Solo dígitos (6 a 10)",
        DocumentType.TI => "Solo dígitos (6 a 11)",
        DocumentType.CE => "Alfanumérico (5 a 12 caracteres)",
        DocumentType.PA => "Alfanumérico (6 a 12 caracteres)",
        _ => "Ingrese su documento"
    };

    // Auto-sugerir el tipo de documento correcto al ingresar la fecha de nacimiento.
    // La VALIDACIÓN la hace el atributo [DocumentTypeForAge] en el modelo.
    private void SuggestDocumentType()
    {
        if (registerModel.DocumentType is DocumentType.CE or DocumentType.PA) return;
        if (registerModel.BirthDate is null) return;
        registerModel.DocumentType = ColombianValidation.ExpectedDocumentType(registerModel.BirthDate);
    }

    private async Task HandleRegister()
    {
        var result = await AuthService.RegisterAsync(registerModel, "Patient");
        if (result.IsSuccess)
        {
            var token = result.Value?.LoginToken;
            if (!string.IsNullOrEmpty(token))
                NavigationManager.NavigateTo($"/auth/apply-session?token={token}&redirect=/", forceLoad: true);
            else
                NavigationManager.NavigateTo("/", forceLoad: true);
        }
        else
        {
            _errorMessage = "No se pudo completar el registro. Intenta de nuevo.";
        }
    }
}