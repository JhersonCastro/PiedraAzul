@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.GraphQLServices
@inject GraphQLAppointmentService AppointmentService

@*
    Modal para vincular (merge) una cuenta invitada con la misma cédula del usuario registrado.
    Verifica identidad con OTP por el canal que tenía la cuenta invitada (WhatsApp/SMS/Email)
    y luego transfiere las citas a la cuenta. No edita datos del usuario.
*@

@if (IsOpen && Guest is not null)
{
    <div class="modal-backdrop"></div>

    <div class="modal-container">
        <div class="modal-panel">

            <div class="modal-header">
                <h2 class="modal-title-sm text-base">Vincular citas anteriores</h2>
                @if (!_loading)
                {
                    <button @onclick="HandleClose" class="btn-close">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
            </div>

            <div class="modal-body">

                @if (_stage == Stage.SelectChannel)
                {
                    <div class="space-y-4">
                        <div class="flex items-start gap-3 rounded-xl bg-teal-50 border border-teal-200 px-4 py-3">
                            <svg class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="text-sm text-teal-800">
                                Encontramos <strong>@Guest.AppointmentCount @(Guest.AppointmentCount == 1 ? "cita" : "citas")</strong>
                                a nombre de <strong>@Guest.GuestName</strong> con tu misma cédula.
                                Verifica tu identidad para traerlas a tu cuenta.
                            </p>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-slate-700">¿Cómo quieres recibir el código?</p>
                            <div class="space-y-2">
                                @if (Guest.HasPhone)
                                {
                                    <button type="button"
                                            @onclick='() => _selectedChannel = "whatsapp"'
                                            class="w-full flex items-center gap-3 rounded-xl border-2 p-3 transition text-left
                                                   @(_selectedChannel == "whatsapp" ? "border-teal-600 bg-teal-50" : "border-slate-200 hover:border-slate-300")">
                                        <svg class="h-6 w-6 flex-shrink-0 @(_selectedChannel == "whatsapp" ? "text-[#25D366]" : "text-slate-500")" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
                                            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.128.558 4.122 1.532 5.855L.057 23.171a.75.75 0 00.92.919l5.355-1.462A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.698-.501-5.254-1.378l-.376-.215-3.898 1.064 1.08-3.818-.233-.386A9.955 9.955 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z" />
                                        </svg>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-semibold @(_selectedChannel == "whatsapp" ? "text-teal-700" : "text-slate-700")">WhatsApp</span>
                                            <span class="text-xs text-slate-600">@Guest.MaskedPhone</span>
                                        </div>
                                    </button>

                                    <button type="button"
                                            @onclick='() => _selectedChannel = "sms"'
                                            class="w-full flex items-center gap-3 rounded-xl border-2 p-3 transition text-left
                                                   @(_selectedChannel == "sms" ? "border-teal-600 bg-teal-50" : "border-slate-200 hover:border-slate-300")">
                                        <svg class="h-6 w-6 flex-shrink-0 @(_selectedChannel == "sms" ? "text-teal-600" : "text-slate-500")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                        </svg>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-semibold @(_selectedChannel == "sms" ? "text-teal-700" : "text-slate-700")">SMS</span>
                                            <span class="text-xs text-slate-600">@Guest.MaskedPhone</span>
                                        </div>
                                    </button>
                                }

                                @if (Guest.HasEmail)
                                {
                                    <button type="button"
                                            @onclick='() => _selectedChannel = "email"'
                                            class="w-full flex items-center gap-3 rounded-xl border-2 p-3 transition text-left
                                                   @(_selectedChannel == "email" ? "border-teal-600 bg-teal-50" : "border-slate-200 hover:border-slate-300")">
                                        <svg class="h-6 w-6 flex-shrink-0 @(_selectedChannel == "email" ? "text-teal-600" : "text-slate-500")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                        </svg>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-semibold @(_selectedChannel == "email" ? "text-teal-700" : "text-slate-700")">Email</span>
                                            <span class="text-xs text-slate-600">@Guest.MaskedEmail</span>
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <p class="alert-error-inline">@_error</p>
                        }

                        <button type="button"
                                @onclick="HandleSendOtp"
                                disabled="@(_loading || string.IsNullOrEmpty(_selectedChannel))"
                                class="btn-action">
                            @(_loading ? "Enviando..." : "Enviar código")
                        </button>
                    </div>
                }
                else if (_stage == Stage.EnterOtp)
                {
                    <div class="flex flex-col items-center gap-4">
                        <p class="text-sm text-slate-600 text-center">
                            Ingresa el código de 6 dígitos que enviamos a @GetChannelLabel().
                        </p>

                        <input type="text"
                               @bind="_otpCode"
                               @bind:event="oninput"
                               maxlength="6"
                               placeholder="000000"
                               class="input input-code w-44 rounded-xl border-2" />

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <p class="alert-error-inline">@_error</p>
                        }

                        <button type="button"
                                @onclick="HandleMerge"
                                disabled="@(_otpCode?.Length != 6 || _loading)"
                                class="btn-action">
                            @(_loading ? "Vinculando..." : "Vincular citas")
                        </button>

                        <button type="button"
                                @onclick="GoBackToChannel"
                                class="text-xs text-teal-700 underline hover:text-teal-900">
                            ¿No recibiste el código? Volver a enviar
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    enum Stage { SelectChannel, EnterOtp }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public MergeableGuestGQL? Guest { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Se invoca tras un merge exitoso con la cantidad de citas transferidas.</summary>
    [Parameter] public EventCallback<int> OnMerged { get; set; }

    private Stage _stage = Stage.SelectChannel;
    private string? _selectedChannel;
    private string? _otpCode;
    private string? _error;
    private bool _loading;

    private string GetChannelLabel() => _selectedChannel switch
    {
        "sms" => Guest?.MaskedPhone ?? "tu teléfono",
        "whatsapp" => Guest?.MaskedPhone ?? "tu WhatsApp",
        "email" => Guest?.MaskedEmail ?? "tu email",
        _ => "tu canal"
    };

    private async Task HandleSendOtp()
    {
        if (Guest is null || string.IsNullOrEmpty(_selectedChannel)) return;
        _error = null;
        _loading = true;

        var result = await AppointmentService.SendGuestOtpByHashAsync(Guest.VerificationHash, _selectedChannel);

        _loading = false;

        if (!result.IsSuccess)
        {
            _error = result.Error?.Message ?? "No se pudo enviar el código. Intenta con otro canal.";
            return;
        }

        _stage = Stage.EnterOtp;
    }

    private async Task HandleMerge()
    {
        if (Guest is null || _otpCode?.Length != 6) return;
        _error = null;
        _loading = true;

        var result = await AppointmentService.MergeGuestAppointmentsAsync(Guest.VerificationHash, _otpCode);

        _loading = false;

        if (!result.IsSuccess || result.Value is null)
        {
            _error = result.Error?.Message ?? "No se pudo vincular. Intenta de nuevo.";
            return;
        }

        if (!result.Value.Success)
        {
            _error = result.Value.Error ?? "Código incorrecto. Intenta de nuevo.";
            return;
        }

        await OnMerged.InvokeAsync(result.Value.MergedCount);
        await HandleClose();
    }

    private void GoBackToChannel()
    {
        _stage = Stage.SelectChannel;
        _otpCode = null;
        _error = null;
    }

    private async Task HandleClose()
    {
        _stage = Stage.SelectChannel;
        _selectedChannel = null;
        _otpCode = null;
        _error = null;
        _loading = false;
        await OnClose.InvokeAsync();
    }
}
