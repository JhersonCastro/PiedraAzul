@using System.Globalization
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.States
@using PiedraAzul.Client.UI.Features.Account.Components
@using PiedraAzul.Client.UI.Features.Booking.Components
@inject GraphQLAppointmentService AppointmentService
@inject UserState UserState

@if (_loading)
{
    <div class="loading-center-lg">
        <div class="spinner"></div>
    </div>
}
else
{
    <div data-tour="patient-appointments-header" class="portal-head">
        <h2 class="portal-title">Mis citas</h2>
        <p class="portal-subtitle">Revisa todas tus citas médicas, tanto pasadas como próximas.</p>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="banner-error mb-4">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="banner-ok-flex mb-4">
            <svg class="icon-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            @_successMessage
        </div>
    }

    @if (_mergeableGuest is not null)
    {
        <div class="mb-4 flex flex-col gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <p class="text-sm text-amber-800">
                    Encontramos una cuenta invitada con tu misma cédula
                    (@_mergeableGuest.AppointmentCount @(_mergeableGuest.AppointmentCount == 1 ? "cita" : "citas")).
                    Vincúlala para traer esas citas a tu perfil.
                </p>
            </div>
            <button @onclick="OpenMergeModal"
                    class="btn-action whitespace-nowrap sm:w-auto">
                Vincular ahora
            </button>
        </div>
    }

    <!-- Tabs -->
    <div class="tabs mb-5">
        <button @onclick='() => _tab = "upcoming"'
                class="tab-btn @(_tab == "upcoming" ? "tab-btn-active" : "tab-btn-idle")">
            Próximas
            @if (_upcoming.Count > 0)
            {
                <span class="tab-badge">@_upcoming.Count</span>
            }
        </button>
        <button @onclick='() => _tab = "past"'
                class="tab-btn @(_tab == "past" ? "tab-btn-active" : "tab-btn-idle")">
            Pasadas
            @if (_past.Count > 0)
            {
                <span class="tab-badge-muted">@_past.Count</span>
            }
        </button>
    </div>

    @if (_tab == "upcoming")
    {
        @if (_upcoming.Count == 0)
        {
            <!-- Empty upcoming -->
            <div class="empty-lg">
                <div class="empty-icon">
                    <svg class="h-7 w-7 text-[#94A3B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                        <path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                </div>
                <p class="empty-title">No tienes citas próximas</p>
                <p class="empty-sub">Cuando reserves una cita aparecerá aquí.</p>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-3">
                @foreach (var appt in _upcoming)
                {
                    <AppointmentCard Appointment="appt"
                                     AllowReschedule="true"
                                     CurrentUserId="@_currentUserId"
                                     OnRescheduleClick="OpenRescheduleModal"
                                     OnCancelClick="(a) => OpenCancelConfirm(a.Id)" />
                }
            </div>
        }
    }
    else
    {
        @if (_past.Count == 0)
        {
            <!-- Empty past -->
            <div class="empty-lg">
                <div class="empty-icon">
                    <svg class="h-7 w-7 text-[#94A3B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                </div>
                <p class="empty-title">Sin historial de citas</p>
                <p class="empty-sub">Tus citas pasadas aparecerán aquí.</p>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-3">
                @foreach (var appt in _past)
                {
                    <AppointmentCard Appointment="appt"
                                     AllowReschedule="false"
                                     CurrentUserId="@_currentUserId" />
                }
            </div>
        }
    }
}

<!-- Cancel Confirm Modal -->
@if (_cancelConfirmId is not null)
{
    <div class="modal-overlay-40" @onclick="CloseCancelConfirm">
        <div class="modal-card-sm" @onclick:stopPropagation>
            <!-- Icon -->
            <div class="modal-icon-danger">
                <svg class="icon-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
            </div>
            <h3 class="modal-title-center">¿Cancelar esta cita?</h3>
            <p class="modal-text-center">
                Esta acción no se puede deshacer. El horario quedará disponible para otros pacientes.
            </p>
            <div class="modal-actions">
                <button @onclick="CloseCancelConfirm"
                        disabled="@_cancelLoading"
                        class="btn-modal-cancel">
                    Volver
                </button>
                <button @onclick="ConfirmCancelAsync"
                        disabled="@_cancelLoading"
                        class="btn-modal-danger">
                    @if (_cancelLoading)
                    {
                        <div class="spinner-inline"></div>
                    }
                    Cancelar cita
                </button>
            </div>
        </div>
    </div>
}

<!-- Reschedule Modal — @key fuerza remontaje al elegir otra cita -->
<RescheduleModal @key="@(_rescheduleAppt?.Id ?? string.Empty)"
                 IsOpen="_rescheduleModalOpen"
                 IsLoading="_rescheduleLoading"
                 OriginalDoctorId="@(_rescheduleAppt?.DoctorId)"
                 OnConfirm="HandleRescheduleConfirm"
                 OnClose="CloseRescheduleModal" />

<!-- Merge de citas de cuenta invitada con la misma cédula -->
<GuestMergeModal IsOpen="_mergeModalOpen"
                 Guest="_mergeableGuest"
                 OnMerged="HandleMerged"
                 OnClose="CloseMergeModal" />

@code {
    private bool _loading = true;
    private string _tab = "upcoming";
    private string? _error;
    private string? _successMessage;

    private List<AppointmentGQL> _upcoming = [];
    private List<AppointmentGQL> _past = [];

    private string? _currentUserId;

    // Reschedule state
    private bool _rescheduleModalOpen;
    private bool _rescheduleLoading;
    private AppointmentGQL? _rescheduleAppt;

    // Cancel state
    private string? _cancelConfirmId;
    private bool _cancelLoading;

    // Merge de cuenta invitada
    private MergeableGuestGQL? _mergeableGuest;
    private bool _mergeModalOpen;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = UserState.User?.Id;
        await LoadAppointmentsAsync();
        await CheckForMergeableGuestAsync();
    }

    private async Task CheckForMergeableGuestAsync()
    {
        var result = await AppointmentService.CheckForMergeableGuestAsync();
        if (result.IsSuccess && result.Value is not null)
        {
            _mergeableGuest = result.Value;
            StateHasChanged();
        }
    }

    private void OpenMergeModal()
    {
        _mergeModalOpen = true;
        _error = null;
        _successMessage = null;
    }

    private void CloseMergeModal() => _mergeModalOpen = false;

    private async Task HandleMerged(int mergedCount)
    {
        _mergeModalOpen = false;
        _mergeableGuest = null;
        _successMessage = mergedCount == 1
            ? "Vinculamos 1 cita anterior a tu cuenta."
            : $"Vinculamos {mergedCount} citas anteriores a tu cuenta.";
        await LoadAppointmentsAsync();
    }

    private async Task LoadAppointmentsAsync()
    {
        _loading = true;
        var result = await AppointmentService.GetMyAppointmentsAsync();
        if (!result.IsSuccess)
        {
            _error = "No se pudieron cargar las citas. Intenta de nuevo.";
        }
        else
        {
            var now = DateTime.Now;
            // Próximas: todas las citas con fecha futura, sin importar el estado.
            // El badge del card muestra Confirmada / Completada / No se presentó / Cancelada.
            _upcoming = result.Value!
                .Where(a => a.Start >= now)
                .OrderBy(a => a.Start)
                .ToList();

            // Pasadas: todas las citas con fecha pasada.
            _past = result.Value!
                .Where(a => a.Start < now)
                .OrderByDescending(a => a.Start)
                .ToList();
        }
        _loading = false;
    }

    private void OpenCancelConfirm(string appointmentId)
    {
        _cancelConfirmId = appointmentId;
        _error = null;
        _successMessage = null;
    }

    private void CloseCancelConfirm()
    {
        if (_cancelLoading) return;
        _cancelConfirmId = null;
    }

    private async Task ConfirmCancelAsync()
    {
        if (_cancelConfirmId is null) return;

        _cancelLoading = true;
        StateHasChanged();

        var result = await AppointmentService.CancelAppointmentAsync(Guid.Parse(_cancelConfirmId));

        _cancelLoading = false;
        _cancelConfirmId = null;

        if (!result.IsSuccess)
        {
            _error = result.Error?.Message ?? "No se pudo cancelar la cita. Intenta de nuevo.";
            StateHasChanged();
            return;
        }

        _successMessage = "Tu cita fue cancelada correctamente.";
        await LoadAppointmentsAsync();
    }

    private void OpenRescheduleModal(AppointmentGQL appt)
    {
        _rescheduleAppt = appt;
        _rescheduleModalOpen = true;
        _error = null;
        _successMessage = null;
    }

    private void CloseRescheduleModal()
    {
        _rescheduleModalOpen = false;
        _rescheduleAppt = null;
    }

    private async Task HandleRescheduleConfirm((string DoctorId, string SlotId, DateTime Date) selection)
    {
        if (_rescheduleAppt is null) return;

        _rescheduleLoading = true;
        StateHasChanged();

        var result = await AppointmentService.RescheduleAppointmentAsync(
            Guid.Parse(_rescheduleAppt.Id),
            Guid.Parse(selection.SlotId),
            selection.Date.ToUniversalTime());

        _rescheduleLoading = false;

        if (!result.IsSuccess)
        {
            _error = result.Error?.Message ?? "No se pudo reagendar la cita. Intenta de nuevo.";
            _rescheduleModalOpen = false;
            _rescheduleAppt = null;
            StateHasChanged();
            return;
        }

        _successMessage = "¡Tu cita fue reagendada exitosamente!";
        _rescheduleModalOpen = false;
        _rescheduleAppt = null;

        // Reload appointments to reflect changes
        await LoadAppointmentsAsync();
    }
}
