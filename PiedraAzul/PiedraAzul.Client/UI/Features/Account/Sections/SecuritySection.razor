@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Contracts.DTOs
@using PiedraAzul.Client.Services.AuthServices
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.States
@using PiedraAzul.Client.UI.Features.Account.Components
@inject PasskeyService PasskeyService
@inject NavigationManager Nav
@inject GraphQLHttpClient GraphQL

<div class="portal-head">
    <h2 class="portal-title">Seguridad</h2>
    <p class="portal-subtitle">Administra tus métodos de acceso y passkeys registradas.</p>
</div>

<!-- Passkeys card -->
<div data-tour="security-passkeys-card" class="portal-card mb-5">
    <div class="mb-4 flex items-start justify-between">
        <div>
            <p class="portal-card-title">Passkeys</p>
            <p class="portal-card-sub">Ingresa con Face ID, huella dactilar o llave USB — sin contraseña.</p>
        </div>
        <button @onclick='() => Nav.NavigateTo("/account/passkeys")'
                class="btn-portal-sm">
            <svg class="icon-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Registrar passkey
        </button>
    </div>

    @if (_loadingPasskeys)
    {
        <div class="loading-center-sm"><div class="spinner"></div></div>
    }
    else if (_passkeys.Count == 0)
    {
        <div class="empty-state">
            No tienes passkeys registradas. Agrega una para acceder sin contraseña.
        </div>
    }
    else
    {
        <div class="flex flex-col gap-2.5">
            @foreach (var pk in _passkeys)
            {
                <div class="portal-row">
                    <div class="flex items-center gap-3">
                        <div class="icon-chip">
                            <svg class="icon-4 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <rect x="5" y="11" width="14" height="10" rx="2"/>
                                <path d="M8 11V7a4 4 0 018 0v4"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-[#0F172A]">@pk.FriendlyName</p>
                            <p class="text-meta">@pk.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
                        </div>
                    </div>
                    <button @onclick="() => DeletePasskeyAsync(pk.Id)" disabled="@_deletingPasskey"
                            class="btn-danger-sm">
                        Eliminar
                    </button>
                </div>
            }
        </div>
    }
</div>

<!-- Password card -->
<div data-tour="security-password-card" class="portal-card">
    <p class="portal-card-title mb-1">Contraseña</p>
    <p class="portal-card-sub mb-4">Cambia tu contraseña actual por una nueva.</p>
    <PasswordChange GraphQL="@GraphQL" />
</div>

@code {
    private List<PasskeyDto> _passkeys = [];
    private bool _loadingPasskeys = true;
    private bool _deletingPasskey;

    protected override async Task OnInitializedAsync() => await LoadPasskeysAsync();

    private async Task LoadPasskeysAsync()
    {
        _loadingPasskeys = true;
        var result = await PasskeyService.GetMyPasskeysAsync();
        _passkeys = result.IsSuccess ? result.Value! : [];
        _loadingPasskeys = false;
    }

    private async Task DeletePasskeyAsync(string id)
    {
        _deletingPasskey = true;
        var result = await PasskeyService.DeletePasskeyAsync(id);
        if (result.IsSuccess) _passkeys.RemoveAll(p => p.Id == id);
        _deletingPasskey = false;
    }
}
