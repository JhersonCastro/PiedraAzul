@using System.Globalization
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.Services
@using PiedraAzul.Client.States
@inject UserState UserState
@inject GraphQLAppointmentService AppointmentService
@inject DoctorPortalState PortalState
@inject IJSRuntime JS

<div>
    <!-- Header + date nav -->
    <div class="portal-section-header-centered">
        <div>
            <h2 class="portal-title">Cronograma diario</h2>
            <p class="portal-subtitle capitalize">
                @SelectedDate.ToString("dddd, dd 'de' MMMM yyyy", new CultureInfo("es-ES"))
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button @onclick="PrevDay" class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#E2E8F0] text-[#94A3B8] transition hover:bg-[#F8FAFC]">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button @onclick="GoToToday" class="rounded-lg bg-[#257D8D] px-4 py-1.5 text-xs font-bold text-white transition hover:opacity-90">
                @GetDateLabel(SelectedDate)
            </button>
            <button @onclick="NextDay" class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#E2E8F0] text-[#94A3B8] transition hover:bg-[#F8FAFC]">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            <div class="relative">
                <button @onclick="AbrirCalendario" class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#E2E8F0] text-[#257D8D] transition hover:bg-[#F8FAFC]">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                </button>
                <input id="docDatePicker" type="date"
                       value="@SelectedDate.ToString("yyyy-MM-dd")"
                       @onchange="HandleDateChange"
                       style="position:absolute;visibility:hidden;width:0;height:0;" />
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">@_error</div>
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_260px]">

        <!-- Table -->
        <div class="table-card">
            @if (_loading)
            {
                <div class="loading-center"><div class="spinner"></div></div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="table-base">
                        <thead>
                            <tr class="table-head-row">
                                <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">Hora</th>
                                <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">Paciente</th>
                                <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">Tipo</th>
                                <th class="px-5 py-4 text-center text-xs font-semibold uppercase tracking-wider text-[#94A3B8]">Estado</th>
                                <th class="table-th-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="table-body">
                            @if (!Appointments.Any())
                            {
                                <tr>
                                    <td colspan="5" class="py-14 text-center text-sm italic text-[#94A3B8]">
                                        No hay citas para este día.
                                    </td>
                                </tr>
                            }
                            @foreach (var app in Appointments)
                            {
                                <tr class="table-row">
                                    <td class="px-5 py-4">
                                        <span class="font-semibold text-[#0F172A]">@app.Start.ToString("hh:mm tt")</span>
                                    </td>
                                    <td class="px-5 py-4">
                                        <p class="font-medium text-[#0F172A]">@(string.IsNullOrWhiteSpace(app.PatientName) ? "Sin nombre" : app.PatientName)</p>
                                        <p class="text-xs text-[#64748B] capitalize">@app.Specialty</p>
                                    </td>
                                    <td class="px-5 py-4">
                                        <span class="inline-flex rounded-full bg-[#E0F7FA] px-2.5 py-0.5 text-[11px] font-semibold text-[#257D8D]">
                                            @(app.PatientType == "Registered" ? "Registrado" : "Invitado")
                                        </span>
                                    </td>
                                    <td class="px-5 py-4 text-center">
                                        @{ var si = GetStatusInfo(app.Status); }
                                        <span class="inline-flex items-center gap-1.5 rounded-full border @si.BadgeClass px-2.5 py-0.5 text-[11px] font-semibold">
                                            <span class="h-1.5 w-1.5 rounded-full @si.DotClass"></span>
                                            @si.Label
                                        </span>
                                    </td>
                                    <td class="px-5 py-4 text-right">
                                        @if (app.Status == "Active")
                                        {
                                            @if (HasStarted(app))
                                            {
                                                <div class="flex items-center justify-end gap-2">
                                                    <button @onclick='() => MarkStatus(app.Id, "Completed")'
                                                            disabled="@_updatingId.Contains(app.Id)"
                                                            class="rounded-lg bg-emerald-500 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-emerald-600 disabled:opacity-50">
                                                        ✓ Completada
                                                    </button>
                                                    <button @onclick='() => MarkStatus(app.Id, "NoShow")'
                                                            disabled="@_updatingId.Contains(app.Id)"
                                                            class="rounded-lg border border-rose-200 bg-white px-3 py-1.5 text-xs font-bold text-rose-500 transition hover:bg-rose-50 disabled:opacity-50">
                                                        ✗ Inasistencia
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-xs font-medium text-amber-500">Programada</span>
                                            }
                                        }
                                        else if (app.Status == "Completed")
                                        {
                                            <span class="text-xs font-semibold text-emerald-600">Atendida</span>
                                        }
                                        else if (app.Status == "NoShow")
                                        {
                                            <span class="text-xs font-semibold text-rose-500">No se presentó</span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-[#94A3B8]">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Sidebar summary -->
        <div class="space-y-4">
            <div class="portal-card">
                <p class="portal-card-title mb-4 uppercase tracking-wider">Resumen del día</p>
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-[#64748B]">Total</span>
                        <span class="text-sm font-bold text-[#0F172A]">@Appointments.Count</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-[#64748B]">Pendientes</span>
                        <span class="text-sm font-bold text-amber-600">@Appointments.Count(a => a.Status == "Active")</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-[#64748B]">Completadas</span>
                        <span class="text-sm font-bold text-emerald-600">@Appointments.Count(a => a.Status == "Completed")</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-[#64748B]">Inasistencias</span>
                        <span class="text-sm font-bold text-rose-500">@Appointments.Count(a => a.Status == "NoShow")</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-[#64748B]">Canceladas</span>
                        <span class="text-sm font-bold text-[#94A3B8]">@Appointments.Count(a => a.Status == "Cancelled")</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigateTo { get; set; }

    private DateTime SelectedDate => PortalState.SelectedDate;
    private List<AppointmentGQL> Appointments = new();
    private bool _loading = true;
    private string? _error;
    private HashSet<string> _updatingId = new();

    protected override async Task OnInitializedAsync() => await LoadAppointmentsAsync();

    // NO usamos OnParametersSetAsync: causaba un loop infinito porque
    // StateHasChanged() dentro de LoadAppointmentsAsync volvía a dispararlo
    // antes de que _lastLoadedDate se actualizara. La carga se maneja
    // directamente desde los botones de navegación.

    private async Task LoadAppointmentsAsync()
    {
        if (UserState?.User?.Id == null) { _loading = false; return; }

        _loading = true;
        _error   = null;
        // NO llamar StateHasChanged() aquí — Blazor detecta el cambio al await
        try
        {
            var result = await AppointmentService.GetDoctorAppointments(UserState.User.Id, SelectedDate);
            Appointments = result.IsSuccess
                ? (result.Value ?? []).OrderBy(a => a.Start).ToList()
                : [];
            if (!result.IsSuccess) _error = "No se pudieron cargar las citas.";
        }
        catch { _error = "Error al cargar las citas."; }
        finally { _loading = false; }
    }

    private async Task MarkStatus(string id, string status)
    {
        _updatingId.Add(id); StateHasChanged();
        var r = await AppointmentService.UpdateAppointmentStatusAsync(Guid.Parse(id), status);
        if (r.IsSuccess)
        {
            var a = Appointments.FirstOrDefault(x => x.Id == id);
            if (a != null) a.Status = status;
        }
        else _error = "No se pudo actualizar el estado.";
        _updatingId.Remove(id); StateHasChanged();
    }

    private async Task PrevDay()    { PortalState.SelectedDate = SelectedDate.AddDays(-1); await LoadAppointmentsAsync(); }
    private async Task NextDay()    { PortalState.SelectedDate = SelectedDate.AddDays(1);  await LoadAppointmentsAsync(); }
    private async Task GoToToday()  { PortalState.SelectedDate = DateTime.Today;           await LoadAppointmentsAsync(); }
    private async Task AbrirCalendario() => await JS.InvokeVoidAsync("eval", "document.getElementById('docDatePicker').showPicker()");
    private async Task HandleDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) { PortalState.SelectedDate = d; await LoadAppointmentsAsync(); }
    }

    private string GetDateLabel(DateTime d)
    {
        var diff = (d.Date - DateTime.Today).Days;
        return diff == 0 ? "Hoy" : diff == -1 ? "Ayer" : diff == 1 ? "Mañana" :
               diff < 0 ? (Math.Abs(diff) >= 31 ? $"Hace {Math.Abs(diff)/30} meses" : $"Hace {Math.Abs(diff)} días") :
                           (diff >= 31 ? $"En {diff/30} meses" : $"En {diff} días");
    }

    /// <summary>
    /// Determina si la cita ya comenzó.
    /// Comparamos en el MISMO frame que usa el display (app.Start).
    /// Así HasStarted es consistente con la hora que ve el usuario en la tabla,
    /// sin importar el Kind con el que llegue app.Start desde el backend.
    /// </summary>
    private static bool HasStarted(AppointmentGQL app)
    {
        return app.Start <= DateTime.Now;
    }

    private record StatusInfo(string Label, string BadgeClass, string DotClass);
    private StatusInfo GetStatusInfo(string s) => s switch
    {
        "Active"      => new("Pendiente",    "border-amber-200/50 bg-amber-50 text-amber-700",   "bg-amber-500"),
        "Completed"   => new("Completada",   "border-emerald-200/50 bg-emerald-50 text-emerald-700", "bg-emerald-500"),
        "NoShow"      => new("Inasistencia", "border-rose-200/50 bg-rose-50 text-rose-600",      "bg-rose-500"),
        "Cancelled"   => new("Cancelada",    "border-slate-200 bg-slate-50 text-slate-500",      "bg-slate-400"),
        "Rescheduled" => new("Reagendada",   "border-slate-200 bg-slate-50 text-slate-500",      "bg-slate-300"),
        _             => new(s,              "border-slate-200 bg-slate-50 text-slate-500",      "bg-slate-300"),
    };
}
