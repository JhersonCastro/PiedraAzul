@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Models.UserProfiles
@using PiedraAzul.Client.States
@using PiedraAzul.Client.Services
@using PiedraAzul.Client.Services.GraphQLServices
@inject UserState UserState
@inject GraphQLAppointmentService AppointmentService
@inject DoctorPortalState PortalState

<div>
    <!-- Header -->
    <div class="portal-head">
        <h2 class="portal-title">Mis Pacientes</h2>
        <p class="portal-subtitle">Pacientes que han tenido citas contigo.</p>
    </div>

    <!-- Search bar -->
    <div class="search-bar-card">
        <div class="search-bar-row">
            <div class="search-input-wrap">
                <div class="search-icon">
                    <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <input type="text"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="FilterPatients"
                       placeholder="Busca por nombre, ID o teléfono..."
                       class="search-input" />
            </div>
            <button @onclick="FilterPatients"
                    class="btn-portal-sm rounded-xl px-6 py-2.5 text-sm">
                Buscar
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-scroll">
            <table class="table-base">
                <thead>
                    <tr class="table-head-row">
                        <th class="table-th">Paciente</th>
                        <th class="table-th">Identificación</th>
                        <th class="table-th">Última visita</th>
                        <th class="table-th">Tipo</th>
                        <th class="table-th-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    @if (isLoading)
                    {
                        <tr><td colspan="5" class="table-loading"><div class="inline-block"><div class="spinner"></div></div></td></tr>
                    }
                    else if (!PagedPatients.Any())
                    {
                        <tr><td colspan="5" class="table-empty">No se encontraron pacientes.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in PagedPatients)
                        {
                            <tr class="table-row">
                                <td class="table-td">
                                    <div class="flex items-center gap-3">
                                        <div class="table-avatar">@GetInitials(p.Name)</div>
                                        <span class="font-medium text-[#0F172A]">@p.Name</span>
                                    </div>
                                </td>
                                <td class="table-td">
                                    <span class="font-mono text-sm text-[#475569]">@p.Id</span>
                                </td>
                                <td class="table-td">
                                    <span class="text-sm text-[#64748B]">@p.LastVisit</span>
                                </td>
                                <td class="table-td">
                                    <span class="@(p.Status == "Registrado" ? "badge-registered" : "badge-guest")">
                                        <span class="h-1.5 w-1.5 rounded-full @(p.Status == "Registrado" ? "bg-emerald-500" : "bg-amber-500")"></span>
                                        @p.Status
                                    </span>
                                </td>
                                <td class="table-td-right">
                                    <button @onclick="() => ShowRecordsMessage(p.Name)"
                                            class="btn-table-outline mr-2">
                                        Ver registros
                                    </button>
                                    <button @onclick="() => NavigateToNewAppointment(p)"
                                            class="btn-table-primary">
                                        + Cita nueva
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Table footer -->
        <div class="table-footer">
            <span class="table-count">
                Mostrando @PagedPatients.Count de @filteredPatients.Count pacientes
            </span>
            @if (TotalPages > 1)
            {
                <div class="pagination">
                    <button @onclick="PrevPage" disabled="@(CurrentPage == 1)" class="page-btn">
                        <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                    @for (int pg = 1; pg <= TotalPages; pg++)
                    {
                        var pgNum = pg;
                        <button @onclick="() => GoToPage(pgNum)"
                                class="@(CurrentPage == pgNum ? "page-btn-active" : "page-btn-idle")">
                            @pgNum
                        </button>
                    }
                    <button @onclick="NextPage" disabled="@(CurrentPage == TotalPages)" class="page-btn">
                        <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_infoMessage))
    {
        <div class="portal-info-banner">@_infoMessage</div>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigateTo { get; set; }

    private List<DoctorPatientGQL> allPatients = new();
    private List<PatientVM> filteredPatients = new();
    private string searchQuery = "";
    private bool isLoading = true;
    private string? _infoMessage;

    private const int PageSize = 10;
    private int CurrentPage = 1;
    private int TotalPages => (int)Math.Ceiling((double)filteredPatients.Count / PageSize);
    private List<PatientVM> PagedPatients => filteredPatients.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (UserState?.User?.Id == null) { isLoading = false; return; }
        isLoading = true;
        var result = await AppointmentService.GetDoctorPatientsAsync(UserState.User.Id);
        if (result.IsSuccess) allPatients = result.Value ?? new();
        FilterPatients();
        isLoading = false;
    }

    private void FilterPatients()
    {
        var q = searchQuery?.Trim().ToLowerInvariant() ?? "";
        var matching = string.IsNullOrWhiteSpace(q)
            ? allPatients
            : allPatients.Where(p =>
                (p.Name?.ToLowerInvariant().Contains(q) ?? false) ||
                (p.Identification?.Contains(q) ?? false) ||
                (p.Phone?.Contains(q) ?? false)).ToList();

        filteredPatients = matching.Select(p => new PatientVM
        {
            Name      = string.IsNullOrWhiteSpace(p.Name) ? "Sin Nombre" : p.Name,
            Id        = string.IsNullOrWhiteSpace(p.Identification) ? "N/A" : p.Identification,
            LastVisit = p.LastVisit.HasValue ? p.LastVisit.Value.ToString("dd/MM/yyyy") : "—",
            Status    = string.Equals(p.Type, "REGISTERED", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(p.Type, "Registered", StringComparison.OrdinalIgnoreCase)
                        ? "Registrado" : "Invitado"
        }).OrderBy(p => p.Name).ToList();

        CurrentPage = 1;
        _infoMessage = null;
    }

    private void PrevPage() { if (CurrentPage > 1) CurrentPage--; }
    private void NextPage() { if (CurrentPage < TotalPages) CurrentPage++; }
    private void GoToPage(int p) => CurrentPage = p;

    private void ShowRecordsMessage(string name) =>
        _infoMessage = $"Los registros médicos de {name} estarán disponibles próximamente.";

    private async Task NavigateToNewAppointment(PatientVM p)
    {
        var raw = allPatients.FirstOrDefault(a => a.Name == p.Name || a.Identification == p.Id);
        PortalState.PreselectedPatient = new PatientModel
        {
            Id                    = raw?.Id ?? "",
            PatientName           = p.Name,
            PatientIdentification = p.Id == "N/A" ? "" : p.Id,
            PatientPhone          = raw?.Phone ?? "",
            Type                  = string.Equals(raw?.Type, "REGISTERED", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(raw?.Type, "Registered", StringComparison.OrdinalIgnoreCase)
                                    ? PatientTypeClient.Registered : PatientTypeClient.Guest
        };
        _infoMessage = null;
        await OnNavigateTo.InvokeAsync("agendar-manual");
    }

    private class PatientVM
    {
        public string Name { get; set; } = "";
        public string Id { get; set; } = "";
        public string LastVisit { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..1].ToUpper() : $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}
