@using PiedraAzul.Client.States
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.Services.AdminServices
@using PiedraAzul.Contracts.Enums
@inject UserState UserState
@inject GraphQLDoctorService DoctorService
@inject GraphQLAppointmentService AppointmentService
@inject UserManagementService UserManagementService

<div>
    <!-- Header -->
    <div class="portal-section-header">
        <div>
            <h2 class="portal-title">Dashboard</h2>
            <p class="portal-subtitle">
                Resumen de tu actividad del día — @DateTime.Now.ToString("dd 'de' MMMM, yyyy", new System.Globalization.CultureInfo("es-ES"))
            </p>
        </div>
        <div class="relative">
            <button @onclick="() => showStatusMenu = !showStatusMenu"
                    class="btn-portal-outline">
                <span class="@(IsActive ? "dot-active" : "dot-inactive")"></span>
                @(IsActive ? "Activo" : "Inactivo")
                <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            @if (showStatusMenu)
            {
                <div class="portal-dropdown">
                    <button @onclick="() => SetStatus(true)" class="portal-dropdown-item">
                        <span class="dot-active"></span> Activo
                    </button>
                    <button @onclick="() => SetStatus(false)" class="portal-dropdown-item">
                        <span class="dot-inactive"></span> Inactivo
                    </button>
                </div>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-center"><div class="spinner"></div></div>
    }
    else
    {
        <!-- Stats Cards -->
        <div class="stat-grid">
            <div class="stat-card">
                <p class="stat-label">Total citas hoy</p>
                <p class="stat-value">@TotalCitas</p>
                <p class="stat-sub">@(Completadas > 0 ? $"{Completadas} completadas" : "Sin citas finalizadas aún")</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Completadas</p>
                <p class="stat-value text-emerald-600">@Completadas</p>
                <p class="stat-sub">@(TotalCitas > 0 ? $"{Completadas * 100 / TotalCitas}% de las citas de hoy" : "—")</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Pendientes</p>
                <p class="stat-value text-amber-500">@Pendientes</p>
                <p class="stat-sub">Siguiente: @(SiguienteCita != null ? SiguienteCita.Start.ToLocalTime().ToString("hh:mm tt") : "N/A")</p>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="quick-grid">
            <button @onclick='() => OnNavigateTo.InvokeAsync("doc-agenda")' class="quick-card">
                <div>
                    <p class="quick-card-title">Mi Agenda</p>
                    <p class="quick-card-sub">Ver calendario y citas del mes</p>
                </div>
                <svg class="icon-6 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            <button @onclick='() => OnNavigateTo.InvokeAsync("doc-cronograma")' class="quick-card">
                <div>
                    <p class="quick-card-title">Cronograma de hoy</p>
                    <p class="quick-card-sub">Ver y gestionar las citas del día</p>
                </div>
                <svg class="icon-6 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            <button @onclick='() => OnNavigateTo.InvokeAsync("doc-pacientes")' class="quick-card">
                <div>
                    <p class="quick-card-title">Mis Pacientes</p>
                    <p class="quick-card-sub">Registros de tus pacientes</p>
                </div>
                <svg class="icon-6 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            <button @onclick='() => OnNavigateTo.InvokeAsync("doc-horario")' class="quick-card">
                <div>
                    <p class="quick-card-title">Mi Horario</p>
                    <p class="quick-card-sub">Configurar disponibilidad semanal</p>
                </div>
                <svg class="icon-6 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigateTo { get; set; }

    private DoctorGQL? CurrentDoctor;
    private List<AppointmentGQL> TodaysAppointments = new();
    private int TotalCitas;
    private int Completadas;
    private int Pendientes;
    private AppointmentGQL? SiguienteCita;
    private bool IsActive = true;
    private bool showStatusMenu;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (UserState?.User?.Id == null) { _loading = false; return; }

        for (int i = 0; i <= 3; i++)
        {
            var type = (DoctorType)i;
            var result = await DoctorService.GetDoctorsByTypeAsync(type.ToGraphQL());
            var myDoc = result.FirstOrDefault(d => d.UserId == UserState.User.Id);
            if (myDoc != null) { CurrentDoctor = myDoc; break; }
        }

        if (CurrentDoctor != null)
        {
            var appts = await AppointmentService.GetDoctorAppointments(CurrentDoctor.UserId, DateTime.Today);
            if (appts.IsSuccess)
            {
                TodaysAppointments = appts.Value ?? new();
                TotalCitas = TodaysAppointments.Count;
                Completadas = TodaysAppointments.Count(a => a.Status == "Completed");
                Pendientes = TodaysAppointments.Count(a => a.Status == "Active");
                var now = DateTime.Now;
                SiguienteCita = TodaysAppointments
                    .Where(a => a.Start.ToLocalTime() >= now && a.Status == "Active")
                    .OrderBy(a => a.Start)
                    .FirstOrDefault();
            }
        }

        _loading = false;
    }

    private async Task SetStatus(bool status)
    {
        if (IsActive == status) { showStatusMenu = false; return; }
        try
        {
            if (UserState?.User?.Id != null)
            {
                var res = await UserManagementService.ToggleUserStatusAsync(UserState.User.Id);
                if (res.IsSuccess && res.Value != null)
                    IsActive = res.Value.IsActive;
                else
                    IsActive = status;
            }
        }
        catch { IsActive = status; }
        showStatusMenu = false;
        StateHasChanged();
    }
}
