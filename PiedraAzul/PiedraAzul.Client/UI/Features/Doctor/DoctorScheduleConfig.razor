@using PiedraAzul.Client.Models.Schedule
@using System.Globalization
@using PiedraAzul.Client.Services.Schedule
@using PiedraAzul.Client.States
@inject UserState UserState
@inject IScheduleConfigService ScheduleConfigService
@inject IJSRuntime JS

<div>
    <!-- Header -->
    <div class="portal-section-header-centered">
        <div>
            <h2 class="portal-title">Mi Horario</h2>
            <p class="portal-subtitle">Gestiona tu disponibilidad semanal para citas con pacientes.</p>
        </div>
        <div class="tab-switcher">
            <button @onclick='() => OnNavigateTo.InvokeAsync("doc-agenda")'
                    class="tab-switcher-idle">
                Calendario
            </button>
            <span class="tab-switcher-active">Mi Horario</span>
        </div>
    </div>

    <div class="schedule-layout">

        <!-- Sidebar legend -->
        <aside class="space-y-4">
            <div class="portal-card">
                <p class="portal-card-title mb-4 uppercase tracking-wider">Leyenda</p>
                <div class="space-y-3">
                    <div class="legend-item">
                        <div class="legend-dot-primary"></div>
                        <span class="legend-text">Disponible</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-dot-idle"></div>
                        <span class="legend-text">Bloqueado</span>
                    </div>
                </div>
                <p class="mt-4 text-xs text-[#94A3B8]">Clic en una franja de @Intervalo min para cambiar disponibilidad.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">

                <div class="portal-card">
                    <p class="portal-card-title mb-3 uppercase tracking-wider">Intervalo</p>
                    <select value="@Intervalo" @onchange="OnIntervalChanged" class="sched-input">
                        <option value="5">5 min</option>
                        <option value="10">10 min</option>
                        <option value="15">15 min</option>
                        <option value="20">20 min</option>
                        <option value="30">30 min</option>
                        <option value="60">60 min</option>
                    </select>
                    <p class="mt-2 text-[11px] text-[#94A3B8]">Detectado: @Intervalo min por slot</p>
                </div>

                <div class="portal-card">
                    <p class="portal-card-title mb-3 uppercase tracking-wider">Franja Horaria</p>
                    <div class="space-y-3">
                        <div>
                            <label class="mb-1 block text-[11px] text-[#64748B]">Apertura</label>
                            <input type="time" value="@StartTimeText" @onchange="OnStartTimeChanged" class="sched-input" />
                        </div>
                        <div>
                            <label class="mb-1 block text-[11px] text-[#64748B]">Cierre</label>
                            <input type="time" value="@EndTimeText" @onchange="OnEndTimeChanged" class="sched-input" />
                        </div>
                    </div>
                    <p class="mt-2 text-[11px] text-[#94A3B8]">Se aplica a todos los días habilitados.</p>
                </div>
            </div>
        </aside>

            <!-- Main Content -->
            <div class="space-y-4">

                @if (_loading)
                {
                    <div class="cal-loading">
                        <div class="spinner"></div>
                        <span>Cargando horario...</span>
                    </div>
                }
                else
                {

                <!-- Schedule Grid -->
                <div class="overflow-hidden rounded-2xl border border-[#E2E8F0] bg-white shadow-sm">
                  <div class="overflow-x-auto">
                   <div class="min-w-[520px]">
                    <div class="grid grid-cols-[100px_1fr_1fr_1fr_1fr_1fr] border-b border-slate-100 bg-slate-50/20">
                        <div class="p-5 flex items-center justify-center text-[10px] font-black text-slate-400 uppercase tracking-widest border-r border-slate-100">Horario</div>
                        @foreach (var day in WeekDays)
                        {
                            <div class="p-5 border-r border-slate-100 last:border-0 text-center relative group @(day.IsBlocked ? "bg-slate-50/50" : "")">
                                <button @onclick="() => ToggleDay(day)" class="block w-full text-center hover:opacity-70 transition-all">
                                    <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">@day.DayName</div>
                                    <div class="text-xl font-black text-slate-900 mb-1">@day.DayNumber</div>
                                    <div class="text-[9px] text-slate-400 mb-3">@(day.IsBlocked ? "—" : GetDayRange(day))</div>
                                </button>
                                <div class="flex justify-center">
                                    <label class="relative inline-flex items-center cursor-pointer group">
                                        <input type="checkbox" checked="@(!day.IsBlocked)" @onchange="() => ToggleDay(day)" class="sr-only peer">
                                        <div class="w-12 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                                    </label>
                                </div>
                                @if (!day.IsBlocked)
                                {
                                    <div class="absolute inset-x-0 bottom-0 h-1.5 bg-primary"></div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Grid Rows -->
                    <div class="divide-y divide-slate-100">
                        @foreach (var hour in Hours)
                        {
                            <div class="grid grid-cols-[100px_1fr_1fr_1fr_1fr_1fr]">
                                <div class="p-5 flex items-start justify-center font-black text-slate-900 text-base border-r border-slate-100">@hour:00</div>
                                @foreach (var day in WeekDays)
                                {
                                    <div class="p-4 border-r border-slate-100 last:border-0 @(day.IsBlocked ? "bg-slate-50/50 flex items-center justify-center italic text-slate-400 font-bold text-sm" : "")">
                                        @if (day.IsBlocked)
                                        {
                                            <span>Bloqueado</span>
                                        }
                                        else
                                        {
                                            <div class="grid grid-cols-1 gap-3">
                                                @foreach (var slot in GetSlotsForHour(day, hour))
                                                {
                                                    <button @onclick="() => slot.IsActive = !slot.IsActive"
                                                            class="w-full py-3.5 px-6 rounded-2xl text-[11px] font-black transition-all border flex items-center justify-between group
                                                                   @(slot.IsActive ? "bg-primary text-white border-primary shadow-xl shadow-primary/20" : "bg-white text-slate-300 border-slate-100 hover:border-slate-300")">
                                                        <span>@slot.StartTime</span>
                                                        @if (!slot.IsActive)
                                                        {
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        
                        <!-- Lunch Break / Bottom padding -->
                        <div class="grid grid-cols-[100px_1fr_1fr_1fr_1fr_1fr] bg-emerald-50/10">
                             <div class="p-5 flex items-start justify-center font-black text-slate-900 text-base border-r border-slate-100">12:00</div>
                             @foreach (var day in WeekDays)
                             {
                                 <div class="p-4 border-r border-slate-100 last:border-0 flex items-center justify-center">
                                     <div class="w-full h-10 bg-primary/10 rounded-2xl border border-primary/5"></div>
                                 </div>
                             }
                        </div>
                    </div>
                   </div>
                  </div>
                </div>

                <!-- Footer Actions -->
                <div class="actions-end-row">
                    @if (!string.IsNullOrEmpty(_saveError))
                    {
                        <span class="text-xs font-bold text-rose-500">@_saveError</span>
                    }
                    @if (_saveSuccess)
                    {
                        <span class="text-xs font-bold text-emerald-600">¡Horario guardado correctamente!</span>
                    }
                    <button @onclick="SaveScheduleAsync"
                            disabled="@_saving"
                            class="btn-save">
                        @if (_saving)
                        {
                            <div class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></div>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        }
                        GUARDAR
                    </button>
                </div>
                } @* end else loading *@
            </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigateTo { get; set; }

    private int Intervalo { get; set; } = 15;
    private string StartTimeText { get; set; } = "08:00";
    private string EndTimeText   { get; set; } = "17:00";
    private List<DayScheduleModel> WeekDays = new();
    private List<int> Hours = new();
    private bool _saving, _loading = true;
    private string? _saveError;
    private bool _saveSuccess;
    private ScheduleConfigModel? _config;

    private static readonly DayOfWeek[] WorkWeek =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday
    ];

    protected override async Task OnInitializedAsync()
    {
        if (UserState?.User?.Id == null) { _loading = false; return; }
        _config = await ScheduleConfigService.GetByDoctorIdAsync(UserState.User.Id);
        if (_config != null)
        {
            Intervalo = DetectIntervalFromSlots(_config);
            SyncTimeRangeFromConfig(_config);
        }
        BuildWeekGrid();
        _loading = false;
    }

    private void SyncTimeRangeFromConfig(ScheduleConfigModel config)
    {
        var (start, end) = ScheduleConfigHelper.DetectTimeRange(config);
        StartTimeText = $"{start.Hours:00}:{start.Minutes:00}";
        EndTimeText   = $"{end.Hours:00}:{end.Minutes:00}";
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        StartTimeText = e.Value?.ToString() ?? StartTimeText;
        ApplyTimeRangeAndRegenerate();
    }

    private void OnEndTimeChanged(ChangeEventArgs e)
    {
        EndTimeText = e.Value?.ToString() ?? EndTimeText;
        ApplyTimeRangeAndRegenerate();
    }

    /// <summary>
    /// Aplica el nuevo rango horario a la config y regenera todos los slots en fresco.
    /// Permite al usuario modificar su horario libremente.
    /// </summary>
    private void ApplyTimeRangeAndRegenerate()
    {
        if (_config is null) return;
        if (!TimeSpan.TryParse(StartTimeText, out var start) ||
            !TimeSpan.TryParse(EndTimeText,   out var end)   || start >= end) return;

        foreach (var day in _config.Availability)
        {
            day.StartTimeSpan = start;
            day.EndTimeSpan   = end;
        }
        RegenerateAllSlots();
    }

    private static int DetectIntervalFromSlots(ScheduleConfigModel config)
        => ScheduleConfigHelper.DetectInterval(config);

    private void BuildWeekGrid()
    {
        var today  = DateTime.Today;
        var monday = today.AddDays(-((7 + (int)today.DayOfWeek - (int)DayOfWeek.Monday) % 7));

        WeekDays = WorkWeek.Select((dow, i) =>
        {
            var dayDate = monday.AddDays(i);
            var avail   = _config?.Availability.FirstOrDefault(a => a.DayOfWeek == dow);
            var isBlocked = avail == null || !avail.IsEnabled;

            var model = new DayScheduleModel
            {
                DayName   = dow.ToString()[..3],
                DayNumber = dayDate.Day,
                DayOfWeek = dow,
                IsBlocked = isBlocked
            };

            if (!isBlocked && _config != null)
                model.Slots = BuildSlotsForDay(dow);

            return model;
        }).ToList();

        // Rango de horas a mostrar: desde el slot más temprano al más tardío de cualquier día
        var allSlots = WeekDays.SelectMany(d => d.Slots).ToList();
        if (allSlots.Any())
        {
            var minHour = allSlots.Min(s => ParseHour(s.StartTime));
            var maxHour = allSlots.Max(s => ParseHour(s.StartTime));
            Hours = Enumerable.Range(minHour, maxHour - minHour + 1).ToList();
        }
        else
        {
            Hours = Enumerable.Range(8, 9).ToList(); // 8:00–16:00 por defecto
        }
    }

    /// <summary>
    /// Construye la lista de slots de un día directamente desde los datos del backend.
    /// Los slots vienen con StartTime y EndTime reales. Solo usamos StartTime para mostrar.
    /// </summary>
    private List<TimeSlotModel> BuildSlotsForDay(DayOfWeek dow)
    {
        if (_config is null) return [];

        var dbSlots = _config.Slots
            .Where(s => s.DayOfWeek == dow)
            .OrderBy(s => s.StartTime)
            .ToList();

        // Si hay slots en la DB, usarlos directamente
        if (dbSlots.Any())
        {
            return dbSlots.Select(s => new TimeSlotModel
            {
                StartTime     = s.StartTime.Length >= 5 ? s.StartTime[..5] : s.StartTime, // "HH:mm"
                IsActive      = !s.IsDeleted,
                IsDeletedInDb = s.IsDeleted
            }).ToList();
        }

        // Si no hay slots en DB para este día, generarlos desde la disponibilidad
        var avail = _config.Availability.FirstOrDefault(a => a.DayOfWeek == dow);
        if (avail is null) return [];

        var startHour = TimeSpan.TryParse(avail.StartTime, out var st) ? st.Hours : 8;
        var endHour   = TimeSpan.TryParse(avail.EndTime,   out var et) ? et.Hours : 17;
        var slots     = new List<TimeSlotModel>();

        for (int h = startHour; h < endHour; h++)
        {
            for (int m = 0; m < 60; m += Intervalo)
            {
                slots.Add(new TimeSlotModel
                {
                    StartTime     = $"{h:D2}:{m:D2}",
                    IsActive      = true,
                    IsDeletedInDb = false
                });
            }
        }

        return slots;
    }

    private static int ParseHour(string time)
    {
        if (time.Length >= 2 && int.TryParse(time[..2], out var h)) return h;
        return 8;
    }

    private IEnumerable<TimeSlotModel> GetSlotsForHour(DayScheduleModel day, int hour)
        => day.Slots.Where(s => ParseHour(s.StartTime) == hour);

    /// <summary>Devuelve la franja horaria del día: "08:00 – 17:00"</summary>
    private string GetDayRange(DayScheduleModel day)
    {
        var active = day.Slots.Where(s => s.IsActive).ToList();
        if (!active.Any()) return "—";
        return $"{active.First().StartTime} – {GetSlotEnd(active.Last())}";
    }

    private string GetSlotEnd(TimeSlotModel slot)
    {
        // Busca el slot real en el config para obtener el EndTime
        if (_config != null)
        {
            var raw = _config.Slots.FirstOrDefault(s =>
                !s.IsDeleted && s.DayOfWeek == WeekDays.FirstOrDefault(d =>
                    d.Slots.Contains(slot))?.DayOfWeek &&
                s.StartTime.StartsWith(slot.StartTime));
            if (raw != null && raw.EndTime.Length >= 5)
                return raw.EndTime[..5];
        }
        // Calcular desde intervalo
        if (slot.StartTime.Length >= 5 &&
            int.TryParse(slot.StartTime[..2], out var h) &&
            int.TryParse(slot.StartTime[3..5], out var m))
        {
            var endMin = m + Intervalo;
            var endH   = endMin >= 60 ? h + 1 : h;
            return $"{endH:D2}:{endMin % 60:D2}";
        }
        return "—";
    }

    private void ToggleDay(DayScheduleModel day)
    {
        day.IsBlocked = !day.IsBlocked;
        if (!day.IsBlocked && !day.Slots.Any())
            day.Slots = BuildSlotsForDay(day.DayOfWeek);
    }

    private void OnIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newInterval) && newInterval >= 5)
        {
            Intervalo = newInterval;
            // Regenerar TODOS los días con el nuevo intervalo
            RegenerateAllSlots();
        }
    }

    /// <summary>
    /// Regenera todos los slots habilitados desde StartTime/EndTime con el intervalo actual.
    /// Usa siempre slots frescos (activos por defecto) para permitir modificar libremente.
    /// </summary>
    private void RegenerateAllSlots()
    {
        if (_config is null) return;

        foreach (var day in WeekDays)
        {
            if (day.IsBlocked) { day.Slots = []; continue; }

            var avail = _config.Availability.FirstOrDefault(a => a.DayOfWeek == day.DayOfWeek);
            int startH = avail != null && TimeSpan.TryParse(avail.StartTime, out var st) ? st.Hours : ParseHour(StartTimeText);
            int endH   = avail != null && TimeSpan.TryParse(avail.EndTime,   out var et) ? et.Hours : ParseHour(EndTimeText);

            day.Slots = GenerateFreshSlots(startH, endH);
        }

        // Recalcular rango de horas visible
        var allSlots = WeekDays.SelectMany(d => d.Slots).ToList();
        if (allSlots.Any())
        {
            var minH = allSlots.Min(s => ParseHour(s.StartTime));
            var maxH = allSlots.Max(s => ParseHour(s.StartTime));
            Hours = Enumerable.Range(minH, maxH - minH + 1).ToList();
        }
    }

    /// <summary>Genera una lista limpia de slots con el intervalo actual.</summary>
    private List<TimeSlotModel> GenerateFreshSlots(int startHour, int endHour)
    {
        var slots = new List<TimeSlotModel>();
        for (int h = startHour; h < endHour; h++)
            for (int m = 0; m < 60; m += Intervalo)
                slots.Add(new TimeSlotModel { StartTime = $"{h:D2}:{m:D2}", IsActive = true });
        return slots;
    }

    private async Task SaveScheduleAsync()
    {
        if (_config == null || UserState?.User?.Id == null) return;
        _saving = true; _saveError = null; _saveSuccess = false; StateHasChanged();

        var activeSlots = new List<SlotItem>();
        foreach (var day in WeekDays.Where(d => !d.IsBlocked))
        {
            foreach (var slot in day.Slots.Where(s => s.IsActive))
            {
                if (!int.TryParse(slot.StartTime.Split(':')[0], out var h) ||
                    !int.TryParse(slot.StartTime.Split(':').ElementAtOrDefault(1) ?? "0", out var m)) continue;

                var endMin = m + Intervalo;
                var endH   = endMin >= 60 ? h + 1 : h;
                activeSlots.Add(new SlotItem
                {
                    DayOfWeek = day.DayOfWeek,
                    StartTime = $"{h:D2}:{m:D2}:00",
                    EndTime   = $"{endH:D2}:{endMin % 60:D2}:00"
                });
            }
        }

        _config.DoctorId       = UserState.User.Id;
        _config.IntervalMinutes = Intervalo;
        _config.ActiveSlots    = activeSlots;

        var result = await ScheduleConfigService.SaveAsync(_config);
        if (result.IsSuccess) { _saveSuccess = true; _config = await ScheduleConfigService.GetByDoctorIdAsync(UserState.User.Id); Intervalo = DetectIntervalFromSlots(_config!); BuildWeekGrid(); }
        else _saveError = result.Error?.Message ?? "No se pudo guardar el horario.";

        _saving = false; StateHasChanged();
    }
}

<style>
    .bg-primary { background-color: #257D8D; }
    .text-primary { color: #257D8D; }
    .border-primary { border-color: #257D8D; }
    .shadow-primary\/20 { --tw-shadow-color: rgba(37, 125, 141, 0.2); }
    .shadow-primary\/30 { --tw-shadow-color: rgba(37, 125, 141, 0.3); }
    .shadow-primary\/40 { --tw-shadow-color: rgba(37, 125, 141, 0.4); }
</style>
