@using System.Globalization
@using PiedraAzul.Client.States
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.Services
@inject UserState UserState
@inject GraphQLAppointmentService AppointmentService
@inject DoctorPortalState PortalState

<div>
    <!-- Header -->
    <div class="portal-section-header-centered">
        <div>
            <h2 class="portal-title">Mi Agenda</h2>
            <p class="portal-subtitle">Visualiza y organiza tus citas mensuales.</p>
        </div>
        <button @onclick='() => OnNavigateTo.InvokeAsync("doc-horario")'
                class="btn-portal-outline">
            <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            Configurar Horario
        </button>
    </div>

    <!-- Calendar -->
    <div class="cal-card">

        <!-- Calendar Header -->
        <div class="cal-header">
            <div class="cal-nav">
                <button @onclick="PreviousMonth" class="cal-nav-btn">
                    <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <h3 class="cal-month-title">
                    @(char.ToUpper(CurrentDate.ToString("MMMM", new CultureInfo("es-ES"))[0]) + CurrentDate.ToString("MMMM yyyy", new CultureInfo("es-ES"))[1..])
                </h3>
                <button @onclick="NextMonth" class="cal-nav-btn">
                    <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>

        <!-- Days of week -->
        <div class="cal-days-header">
            @foreach (var day in DaysOfWeek)
            {
                <div class="cal-day-label">@day[..3]</div>
            }
        </div>

        <!-- Calendar Grid -->
        @if (_loading)
        {
            <div class="cal-loading">
                <div class="spinner"></div>
                <span>Cargando citas...</span>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <div class="cal-grid" style="min-height:420px">
                    @foreach (var date in CalendarDays)
                    {
                        var isCurrentMonth = date.Month == CurrentDate.Month;
                        var isToday = date.Date == DateTime.Today;

                        <div @onclick="() => IrACronograma(date)"
                             class="cal-cell @(isCurrentMonth ? "" : "opacity-40")">

                            <span class="@(isToday ? "cal-day-today" : "cal-day-normal")">
                                @date.Day
                            </span>

                            <div class="mt-1 space-y-0.5 overflow-hidden">
                                @if (MonthlyAppointments.ContainsKey(date.Date))
                                {
                                    var apps = MonthlyAppointments[date.Date];
                                    @foreach (var app in apps.Take(2))
                                    {
                                        <div class="truncate rounded px-1 py-0.5 text-[10px] font-semibold @GetAppBadgeClass(app.Status)">
                                            @app.Time · @app.Patient
                                        </div>
                                    }
                                    @if (apps.Count > 2)
                                    {
                                        <div class="cal-more">+@(apps.Count - 2) más</div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigateTo { get; set; }

    private DateTime CurrentDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string[] DaysOfWeek = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
    private List<DateTime> CalendarDays = new();
    private bool _loading;
    private Dictionary<DateTime, List<AppointmentVM>> MonthlyAppointments = new();

    protected override async Task OnInitializedAsync()
    {
        CalculateCalendar();
        await LoadAppointmentsAsync();
    }

    private void CalculateCalendar()
    {
        CalendarDays.Clear();
        var first = new DateTime(CurrentDate.Year, CurrentDate.Month, 1);
        int offset = ((int)first.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        var start = first.AddDays(-offset);
        for (int i = 0; i < 35; i++) CalendarDays.Add(start.AddDays(i));
    }

    private async Task PreviousMonth()
    {
        CurrentDate = CurrentDate.AddMonths(-1);
        CalculateCalendar();
        await LoadAppointmentsAsync();
    }

    private async Task NextMonth()
    {
        CurrentDate = CurrentDate.AddMonths(1);
        CalculateCalendar();
        await LoadAppointmentsAsync();
    }

    private async Task IrACronograma(DateTime date)
    {
        PortalState.SelectedDate = date;
        await OnNavigateTo.InvokeAsync("doc-cronograma");
    }

    private async Task LoadAppointmentsAsync()
    {
        if (UserState?.User?.Id == null) return;
        _loading = true; StateHasChanged();
        try
        {
            var result = await AppointmentService.GetDoctorAppointments(UserState.User.Id, null);
            if (!result.IsSuccess) return;

            MonthlyAppointments.Clear();
            var byDate = (result.Value ?? new()).GroupBy(a => a.Start.ToLocalTime().Date);
            foreach (var g in byDate)
            {
                MonthlyAppointments[g.Key] = g.OrderBy(a => a.Start).Select(a => new AppointmentVM
                {
                    Time    = a.Start.ToLocalTime().ToString("HH:mm"),
                    Patient = string.IsNullOrWhiteSpace(a.PatientName) ? "Paciente" : a.PatientName.Split(' ')[0],
                    Status  = a.Status
                }).ToList();
            }
        }
        finally { _loading = false; }
    }

    private string GetAppBadgeClass(string status) => status switch
    {
        "Active"    => "bg-[#E0F7FA] text-[#257D8D]",
        "Completed" => "bg-emerald-50 text-emerald-700",
        "NoShow"    => "bg-rose-50 text-rose-600",
        "Cancelled" => "bg-slate-100 text-slate-500",
        _           => "bg-slate-100 text-slate-500",
    };

    private class AppointmentVM
    {
        public string Time { get; set; } = "";
        public string Patient { get; set; } = "";
        public string Status { get; set; } = "";
    }
}
