@page "/booking/manual"
@using PiedraAzul.Client.Models.Booking
@using PiedraAzul.Client.Models.UserProfiles
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.Services.Utils
@using PiedraAzul.Client.UI.Features.Booking.Components
@using PiedraAzul.Client.UI.Shared.Components

@inject GraphQLAppointmentService AppointmentService

<EditForm Model="@Model" OnSubmit="HandlerSubmit">
    <div class="booking-page">

        <!-- HEADER -->
        <div data-tour="manual-booking-header" class="space-y-1">
            <h1 class="page-heading">Agendamiento Manual</h1>
            <p class="page-subheading">Registro de nueva cita médica y servicios terapéuticos</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div class="alert-error-inline">@_errorMsg</div>
        }

        <!-- PACIENTE -->
        <div class="booking-section">
            <h2 class="booking-section-title">Datos del Paciente</h2>

            @if (SelectedPatient != null)
            {
                <div class="selected-patient">
                    <div>
                        <p class="text-sm font-bold text-[#257D8D]">@SelectedPatient.PatientName</p>
                        <p class="mt-0.5 text-xs text-[#257D8D]">
                            @if (!string.IsNullOrEmpty(SelectedPatient.PatientIdentification))
                            {
                                <span>CC: @SelectedPatient.PatientIdentification &bull; </span>
                            }
                            @SelectedPatient.PatientPhone &bull;
                            <span class="font-medium">@(SelectedPatient.IsRegistered ? "Registrado" : "Invitado")</span>
                        </p>
                    </div>
                    <button type="button" @onclick="ClearPatient"
                            class="text-xs font-semibold text-slate-500 transition-colors hover:text-red-500">
                        Cambiar
                    </button>
                </div>
            }
            else
            {
                <button type="button" @onclick="OpenPatientModal" class="btn-patient-search">
                    <svg class="icon-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                    </svg>
                    Buscar o registrar paciente
                </button>
            }
        </div>

        <!-- DETALLES -->
        <div class="booking-section">
            <h2 class="booking-section-title">Detalles de la Cita</h2>

            <div class="grid gap-6">
                @if (_isAdmin)
                {
                    <div class="space-y-4">
                        <MenuTypeMedic OnSelected="HandlerSelectDoctor" OnChange="HandlerChange" />
                    </div>
                }
                else if (_isDoctor)
                {
                    <div class="doctor-info-row">
                        <svg class="icon-6 flex-shrink-0 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <div>
                            <p class="text-xs font-medium text-slate-500">Doctor asignado</p>
                            <p class="text-sm font-bold text-slate-900">@_currentUserName</p>
                        </div>
                        <span class="ml-auto rounded-full bg-[#e8f5f3] px-2 py-0.5 text-xs font-medium text-[#257D8D]">Tú</span>
                    </div>
                }

                <div class="space-y-4">
                    @if (!string.IsNullOrWhiteSpace(Model.DoctorId))
                    {
                        <AppointmentScheduler DoctorId="@Model.DoctorId"
                                              OnSelected="HandlerSelectAppointmentDate" />
                    }
                    else
                    {
                        <div class="placeholder-slot">
                            Selecciona un médico para continuar
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ACCIONES -->
        <div class="booking-actions">
            <button type="submit" disabled="@_isSubmitting" class="btn-booking-submit">
                @if (_isSubmitting)
                {
                    <svg class="icon-4 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
                    </svg>
                }
                Guardar agendamiento
            </button>

            <button type="button" @onclick="HandlerCancel" class="btn-booking-cancel">
                Cancelar
            </button>
        </div>

    </div>
</EditForm>

<PatientSearchModal IsOpen="@_patientModalOpen"
                    OnPatientSelected="OnPatientSelected"
                    OnCancel="OnPatientModalCancel" />

<LoadingOverlay Visible="_isSubmitting"
                Title="Guardando la cita…"
                Message="Estamos registrando la cita en el sistema. Esto tomará solo un momento." />
