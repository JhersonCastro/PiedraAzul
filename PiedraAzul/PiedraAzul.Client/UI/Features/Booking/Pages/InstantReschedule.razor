@page "/reagendar"

@using System.Globalization
@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.States
@using PiedraAzul.Client.UI.Features.Booking.Components

<CascadingValue Value="@this" IsFixed="false">

@if (UIModeState.IsEasy)
{
    <InstantRescheduleEasyContent />
}
else
{

<div class="min-h-screen bg-gradient-to-b from-[#F0FDFA] to-white py-8 px-4">
    <div class="mx-auto max-w-xl">

        <!-- Header -->
        <div class="mb-8 text-center">
            <div class="empty-icon mx-auto mb-3">
                <svg class="h-7 w-7 text-[#257D8D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
            <h1 class="portal-title text-center text-2xl">Reagendar Cita</h1>
            <p class="portal-subtitle text-center mt-1">Ingresa tu número de identificación para ver tus citas y reagendarlas.</p>
        </div>

        @if (_isSuccess)
        {
            <!-- Success state -->
            <div class="rounded-2xl border border-green-200 bg-green-50 p-8 text-center">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-green-100">
                    <svg class="h-7 w-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h2 class="text-lg font-bold text-green-800">¡Cita reagendada!</h2>
                <p class="mt-1 text-sm text-green-700">Tu cita fue reagendada exitosamente.</p>
                <button @onclick="ResetAll"
                        class="mt-5 rounded-xl bg-[#257D8D] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#1a5f6d] transition">
                    Reagendar otra cita
                </button>
            </div>
        }
        else if (_stage == Stage.Identification)
        {
            <!-- Stage 0: Enter ID -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <label class="label-sm">Número de identificación</label>
                <input @bind="_identification" @bind:event="oninput" @onkeydown="OnIdKeyDown"
                       type="text" placeholder="Ej: 1150064123"
                       class="w-full rounded-xl border-2 border-slate-200 px-4 py-3 text-sm focus:border-[#257D8D] focus:outline-none transition" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="mt-2 text-sm text-red-600">@_error</p>
                }

                <button @onclick="StartSearchAsync"
                        disabled="@(_searching || string.IsNullOrWhiteSpace(_identification))"
                        class="mt-4 w-full rounded-xl bg-[#257D8D] py-3 text-sm font-bold text-white hover:bg-[#1a5f6d] transition disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                    @if (_searching)
                    {
                        <div class="h-4 w-4 animate-spin rounded-full border-b-2 border-white"></div>
                    }
                    Buscar mis citas
                </button>
            </div>
        }
        else if (_stage == Stage.Appointments)
        {
            <!-- Stage 2: Show appointments + reschedule button -->
            <div>
                <div class="mb-4 flex items-center gap-2">
                    <button @onclick="() => { _stage = Stage.Identification; _error = null; }"
                            class="flex items-center gap-1 text-sm text-slate-500 hover:text-[#257D8D] transition">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                        </svg>
                        Volver
                    </button>
                    <span class="text-sm font-semibold text-slate-800">
                        @(_inGuestContext ? "Citas como invitado" : "Citas próximas")
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">@_error</div>
                }

                @* Banner: registrado que además tiene citas bajo una cuenta invitada (misma cédula) *@
                @if (!_inGuestContext && !_loadingAppointments && (_searchResult?.GuestAppointmentCount ?? 0) > 0)
                {
                    <div class="mb-4 flex flex-col gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="text-sm text-amber-800">
                                ¿No encuentras tu cita? Tienes
                                <strong>@_searchResult!.GuestAppointmentCount @(_searchResult.GuestAppointmentCount == 1 ? "cita" : "citas")</strong>
                                a nombre de una cuenta invitada con tu misma cédula.
                            </p>
                        </div>
                        <button @onclick="OnVerifyGuestAppointments"
                                class="whitespace-nowrap rounded-xl bg-amber-600 px-4 py-2 text-sm font-bold text-white hover:bg-amber-700 transition sm:w-auto">
                            Verificar y ver
                        </button>
                    </div>
                }

                @if (_loadingAppointments)
                {
                    <div class="flex justify-center py-16">
                        <div class="h-7 w-7 animate-spin rounded-full border-b-2 border-[#257D8D]"></div>
                    </div>
                }
                else if (_appointments.Count == 0)
                {
                    <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center">
                        <p class="text-[15px] font-bold text-[#0F172A]">No tienes citas próximas</p>
                        <p class="mt-1 text-[13px] text-[#94A3B8]">No se encontraron citas activas para reagendar.</p>
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-3">
                        @foreach (var appt in _appointments)
                        {
                            var dateStr = char.ToUpper(appt.Start.ToString("dddd", new CultureInfo("es-ES"))[0])
                                          + appt.Start.ToString("dddd, d 'de' MMMM yyyy", new CultureInfo("es-ES"))[1..];
                            var timeStr = appt.Start.ToString("hh:mm tt", CultureInfo.InvariantCulture);

                            <div class="rounded-2xl border border-[#BAE6FD] bg-white p-4 flex gap-4 items-start shadow-sm">
                                <div class="flex-shrink-0 h-11 w-11 rounded-xl flex items-center justify-center bg-[#E0F2FE]">
                                    <svg class="h-5 w-5 text-[#0284C7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                                        <path d="M16 2v4M8 2v4M3 10h18"/>
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <p class="text-[14px] font-bold text-[#0F172A]">Dr. @appt.DoctorName</p>
                                        @if (!string.IsNullOrEmpty(appt.Specialty))
                                        {
                                            <span class="rounded-full bg-[#F1F5F9] px-2 py-0.5 text-[11px] font-semibold text-[#475569]">@appt.Specialty</span>
                                        }
                                    </div>
                                    <p class="mt-1 text-[12px] text-[#64748B] capitalize">@dateStr · @timeStr</p>
                                </div>
                                <button @onclick="() => OpenRescheduleModal(appt)"
                                        class="flex-shrink-0 flex items-center gap-1.5 rounded-xl border border-[#257D8D] px-3 py-1.5 text-[12px] font-semibold text-[#257D8D] hover:bg-[#e8f5f3] transition">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                    </svg>
                                    Reagendar
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }

    </div>
</div>

<!-- PatientVerificationModal -->
<PatientVerificationModal IsOpen="_showVerificationModal"
                          IsLoading="_searching"
                          SearchResultType="@_searchResultType"
                          ErrorMessage="@_searchError"
                          OnRegisteredLogin="OnRegisteredLogin"
                          OnRegisteredGuestContinue="OnGuestContinue"
                          OnGuestContinue="OnGuestContinue"
                          OnNewPatientContinue="OnNotFound"
                          OnRetry="OnRetrySearch"
                          OnClose="OnVerificationModalClose" />

<!-- ChannelValidationModal — @key fuerza remontaje al cambiar de hash (registrado ↔ invitado) -->
<ChannelValidationModal @key="@_verificationHash"
                        IsOpen="_showChannelModal"
                        IsLoading="_channelLoading"
                        HasPhone="@_activeHasPhone"
                        HasEmail="@_activeHasEmail"
                        MaskedPhone="@_activeMaskedPhone"
                        MaskedEmail="@_activeMaskedEmail"
                        OnSendOtp="SendOtpByHashAsync"
                        OnVerifyOtp="VerifyOtpByHashAsync"
                        OnConfirmData="OnChannelConfirm"
                        OnClose="OnChannelModalClose" />

<!-- RescheduleModal — @key fuerza remontaje al elegir otra cita -->
<RescheduleModal @key="@(_selectedAppt?.Id ?? string.Empty)"
                 IsOpen="_showRescheduleModal"
                 IsLoading="_rescheduleLoading"
                 OriginalDoctorId="@(_selectedAppt?.DoctorId)"
                 OnConfirm="HandleRescheduleConfirm"
                 OnClose="() => { _showRescheduleModal = false; _selectedAppt = null; }" />

} @* fin else modo moderno *@

</CascadingValue>
