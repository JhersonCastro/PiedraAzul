@using PiedraAzul.Client.Models.Booking
@using PiedraAzul.Client.Models.UserProfiles
@using PiedraAzul.Client.Services.GraphQLServices
@using PiedraAzul.Client.States
@using PiedraAzul.Contracts.Enums
@inject UIModeState UIModeState

@if (IsOpen)
{
    <div class="modal-backdrop"></div>

    <div class="modal-container @(UIModeState.IsEasy ? "easy-modal" : "")">
        <div class="modal-panel-xl">

            <!-- Header -->
            <div class="modal-header flex-shrink-0">
                <div class="flex items-center gap-3">
                    <!-- Step dots -->
                    <div class="flex gap-1.5">
                        @for (int i = 0; i < 3; i++)
                        {
                            var idx = i;
                            <div class="@(idx == _stepIndex ? "step-dot-active" : idx < _stepIndex ? "step-dot-done" : "step-dot-idle")"></div>
                        }
                    </div>
                    <h2 class="text-base font-bold text-slate-900">@GetTitle()</h2>
                </div>
                @if (!IsLoading)
                {
                    <button @onclick="HandleClose" class="btn-close">
                        <svg class="icon-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
            </div>

            <!-- Body -->
            <div class="modal-body-scroll">

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert-error-inline mb-4">@_error</div>
                }

                @if (IsLoading)
                {
                    <div class="loading-center">
                        <div class="spinner-modal"></div>
                    </div>
                }
                else if (_stepIndex == 0)
                {
                    @if (OriginalDoctorId is not null)
                    {
                        <p class="mb-4 text-sm text-slate-600">
                            Puedes mantener el mismo médico o elegir uno diferente para tu nueva cita.
                        </p>
                    }
                    <MenuTypeMedic OnSelected="HandleDoctorSelected" />
                }
                else if (_stepIndex == 1)
                {
                    @if (!string.IsNullOrEmpty(_selectedDoctorId))
                    {
                        <AppointmentScheduler DoctorId="@_selectedDoctorId"
                                              OnSelected="HandleSlotSelected"
                                              @key="_selectedDoctorId" />
                    }
                }
                else if (_stepIndex == 2)
                {
                    <div class="space-y-4">
                        <div class="alert alert-amber">
                            <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.073 16.5c-.77.833.192 2.5 1.732 2.5z" />
                            </svg>
                            <p class="text-sm text-amber-800">
                                Tu cita anterior quedará marcada como reagendada. Esta acción no se puede deshacer.
                            </p>
                        </div>

                        <div class="summary-table">
                            <div class="summary-row">
                                <span class="summary-label">Médico</span>
                                <span class="summary-value">@_selectedDoctorName</span>
                            </div>
                            <div class="summary-row">
                                <span class="summary-label">Fecha</span>
                                <span class="summary-value capitalize">
                                    @(_selectedSlot is not null ? _selectedSlot.Date.ToString("dddd, d 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES")) : "-")
                                </span>
                            </div>
                            <div class="summary-row">
                                <span class="summary-label">Hora</span>
                                <span class="summary-value">@(_selectedSlot?.Time ?? "-")</span>
                            </div>
                        </div>
                    </div>
                }

            </div>

            <!-- Footer -->
            <div class="modal-footer flex flex-shrink-0 items-center justify-between gap-3">
                @if (_stepIndex > 0)
                {
                    <button type="button" @onclick="GoBack" disabled="@IsLoading" class="btn-modal-back">
                        Atrás
                    </button>
                }
                else
                {
                    <div></div>
                }

                @if (_stepIndex < 2)
                {
                    <button type="button" @onclick="GoNext"
                            disabled="@(!CanGoNext() || IsLoading)"
                            class="btn-modal-next">
                        Siguiente
                    </button>
                }
                else
                {
                    <button type="button" @onclick="ConfirmReschedule"
                            disabled="@IsLoading"
                            class="btn-modal-confirm">
                        @if (IsLoading)
                        {
                            <div class="h-4 w-4 animate-spin rounded-full border-b-2 border-white"></div>
                        }
                        Confirmar reagendamiento
                    </button>
                }
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? OriginalDoctorId { get; set; }
    [Parameter] public EventCallback<(string DoctorId, string SlotId, DateTime Date)> OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int _stepIndex = 0;
    private string? _error;
    private string? _selectedDoctorId;
    private string? _selectedDoctorName;
    private AppointmentSchedulerModel? _selectedSlot;

    private void HandleDoctorSelected(DoctorModel? doctor)
    {
        if (doctor is null) { _selectedDoctorId = null; _selectedDoctorName = null; }
        else { _selectedDoctorId = doctor.Id; _selectedDoctorName = doctor.Name; _selectedSlot = null; }
    }

    private void HandleSlotSelected(AppointmentSchedulerModel slot) => _selectedSlot = slot;

    private bool CanGoNext() => _stepIndex switch
    {
        0 => !string.IsNullOrEmpty(_selectedDoctorId),
        1 => _selectedSlot is not null,
        _ => false
    };

    private void GoNext() { _error = null; if (_stepIndex < 2) _stepIndex++; }
    private void GoBack()  { _error = null; if (_stepIndex > 0) _stepIndex--; }

    private string GetTitle() => _stepIndex switch
    {
        0 => "Elige el médico",
        1 => "Elige el día y hora",
        _ => "Confirmar reagendamiento"
    };

    private async Task ConfirmReschedule()
    {
        if (string.IsNullOrEmpty(_selectedDoctorId) || _selectedSlot is null) return;
        await OnConfirm.InvokeAsync((_selectedDoctorId, _selectedSlot.SlotId, _selectedSlot.Date));
    }

    private async Task HandleClose() { ResetState(); await OnClose.InvokeAsync(); }

    private void ResetState()
    {
        _stepIndex = 0; _error = null;
        _selectedDoctorId = null; _selectedDoctorName = null; _selectedSlot = null;
    }
}
