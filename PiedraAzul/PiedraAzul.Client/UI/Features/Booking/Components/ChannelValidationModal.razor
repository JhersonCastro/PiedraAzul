@using PiedraAzul.Client.Models.GraphQL
@using PiedraAzul.Client.States
@inject UIModeState UIModeState

@*
    Modal de validación de canal para FLUJO 2 (usuario registrado) y FLUJO 3 (guest invitado).
    Tiene 3 estados internos:
    1. SelectChannel - mostrar datos enmascarados y selector de canal
    2. EnterOtp - ingresar código OTP
    3. ConfirmData - mostrar formulario editable con datos NO enmascarados (después de verificar OTP)
*@

@if (IsOpen)
{
    <div class="modal-backdrop"></div>

    <div class="modal-container @(UIModeState.IsEasy ? "easy-modal" : "")">
        <div class="modal-panel">

            <!-- Header -->
            <div class="modal-header">
                <h2 class="modal-title-sm text-base">@GetTitle()</h2>
                @if (!IsLoading && _stage != Stage.ConfirmData)
                {
                    <button @onclick="HandleClose"
                            class="btn-close">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
            </div>

            <!-- Body -->
            <div class="modal-body">

                @if (_stage == Stage.SelectChannel)
                {
                    <div class="space-y-4">
                        <div class="flex items-start gap-3 rounded-xl bg-[#e8f5f3] border border-[#257D8D]/30 px-4 py-3">
                            <svg class="w-5 h-5 text-[#257D8D] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="text-sm text-[#257D8D]">
                                Para continuar, verifica tu identidad. Te enviaremos un código por el canal que elijas.
                            </p>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-slate-700">¿Cómo quieres recibir el código?</p>
                            <div class="space-y-2">
                                @if (HasPhone)
                                {
                                    <button type="button"
                                            @onclick='() => _selectedChannel = "whatsapp"'
                                            class="w-full flex items-center gap-3 rounded-xl border-2 p-3 transition text-left
                                                   @(_selectedChannel == "whatsapp" ? "border-[#257D8D] bg-[#e8f5f3]" : "border-slate-200 hover:border-slate-300")">
                                        <svg class="h-6 w-6 flex-shrink-0 @(_selectedChannel == "whatsapp" ? "text-[#25D366]" : "text-slate-500")" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
                                            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.128.558 4.122 1.532 5.855L.057 23.171a.75.75 0 00.92.919l5.355-1.462A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.698-.501-5.254-1.378l-.376-.215-3.898 1.064 1.08-3.818-.233-.386A9.955 9.955 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z" />
                                        </svg>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-semibold @(_selectedChannel == "whatsapp" ? "text-[#257D8D]" : "text-slate-700")">WhatsApp</span>
                                            <span class="text-xs text-slate-600">@MaskedPhone</span>
                                        </div>
                                    </button>

                                    <button type="button"
                                            @onclick='() => _selectedChannel = "sms"'
                                            class="w-full flex items-center gap-3 rounded-xl border-2 p-3 transition text-left
                                                   @(_selectedChannel == "sms" ? "border-[#257D8D] bg-[#e8f5f3]" : "border-slate-200 hover:border-slate-300")">
                                        <svg class="h-6 w-6 flex-shrink-0 @(_selectedChannel == "sms" ? "text-[#257D8D]" : "text-slate-500")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                        </svg>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-semibold @(_selectedChannel == "sms" ? "text-[#257D8D]" : "text-slate-700")">SMS</span>
                                            <span class="text-xs text-slate-600">@MaskedPhone</span>
                                        </div>
                                    </button>
                                }

                                @if (HasEmail)
                                {
                                    <button type="button"
                                            @onclick='() => _selectedChannel = "email"'
                                            class="w-full flex items-center gap-3 rounded-xl border-2 p-3 transition text-left
                                                   @(_selectedChannel == "email" ? "border-[#257D8D] bg-[#e8f5f3]" : "border-slate-200 hover:border-slate-300")">
                                        <svg class="h-6 w-6 flex-shrink-0 @(_selectedChannel == "email" ? "text-[#257D8D]" : "text-slate-500")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                        </svg>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-semibold @(_selectedChannel == "email" ? "text-[#257D8D]" : "text-slate-700")">Email</span>
                                            <span class="text-xs text-slate-600">@MaskedEmail</span>
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <p class="alert-error-inline">@_error</p>
                        }

                        <button type="button"
                                @onclick="HandleSendOtp"
                                disabled="@(IsLoading || string.IsNullOrEmpty(_selectedChannel))"
                                class="btn-action">
                            @(IsLoading ? "Enviando..." : "Enviar código")
                        </button>
                    </div>
                }
                else if (_stage == Stage.EnterOtp)
                {
                    <div class="flex flex-col items-center gap-4">
                        <p class="text-sm text-slate-600 text-center">
                            Ingresa el código de 6 dígitos que enviamos a @GetChannelLabel().
                        </p>

                        <input type="text"
                               @bind="_otpCode"
                               @bind:event="oninput"
                               maxlength="6"
                               placeholder="000000"
                               class="input input-code w-44 rounded-xl border-2" />

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <p class="alert-error-inline">@_error</p>
                        }

                        <button type="button"
                                @onclick="HandleVerifyOtp"
                                disabled="@(_otpCode?.Length != 6 || IsLoading)"
                                class="btn-action">
                            @(IsLoading ? "Verificando..." : "Verificar")
                        </button>

                        <button type="button"
                                @onclick="GoBackToChannel"
                                class="text-xs text-[#257D8D] underline hover:text-[#1E5F6F]">
                            ¿No recibiste el código? Volver a enviar
                        </button>
                    </div>
                }
                else if (_stage == Stage.ConfirmData)
                {
                    <div class="space-y-4">
                        <div class="flex items-start gap-3 rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3">
                            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <p class="text-sm text-emerald-800">
                                @(_isRegisteredUser
                                    ? "Identidad verificada. Estos son los datos de tu cuenta."
                                    : "Identidad verificada. Confirma o actualiza tus datos antes de continuar.")
                            </p>
                        </div>

                        <div>
                            <label class="label-modal">Nombre completo</label>
                            <input type="text"
                                   @bind="_editName"
                                   @bind:event="oninput"
                                   readonly="@_isRegisteredUser"
                                   class="input-modal @(_isRegisteredUser ? "bg-slate-100 text-slate-500 cursor-not-allowed" : "")" />
                        </div>

                        <div>
                            <label class="label-modal">Teléfono</label>
                            <input type="tel"
                                   @bind="_editPhone"
                                   @bind:event="oninput"
                                   readonly="@_isRegisteredUser"
                                   class="input-modal @(_isRegisteredUser ? "bg-slate-100 text-slate-500 cursor-not-allowed" : "")" />
                        </div>

                        <div>
                            <label class="label-modal">Email @(_isRegisteredUser ? "" : "(opcional)")</label>
                            <input type="email"
                                   @bind="_editEmail"
                                   @bind:event="oninput"
                                   readonly="@_isRegisteredUser"
                                   class="input-modal @(_isRegisteredUser ? "bg-slate-100 text-slate-500 cursor-not-allowed" : "")" />
                        </div>

                        @if (_isRegisteredUser)
                        {
                            <p class="text-xs text-slate-500">
                                Para cambiar tus datos, ingresa a tu cuenta y edítalos en tu perfil.
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <p class="alert-error-inline">@_error</p>
                        }

                        <button type="button"
                                @onclick="HandleConfirmData"
                                disabled="@(IsLoading || string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editPhone))"
                                class="btn-action">
                            @(IsLoading
                                ? "Cargando..."
                                : (_isRegisteredUser ? "Continuar" : "Confirmar y continuar"))
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    enum Stage { SelectChannel, EnterOtp, ConfirmData }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool HasPhone { get; set; }
    [Parameter] public bool HasEmail { get; set; }
    [Parameter] public string? MaskedPhone { get; set; }
    [Parameter] public string? MaskedEmail { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ExternalError { get; set; }

    /// <summary>Callback que envía OTP. Recibe el canal seleccionado. Retorna true si el envío fue exitoso.</summary>
    [Parameter] public Func<string, Task<bool>>? OnSendOtp { get; set; }

    /// <summary>
    /// Callback que verifica OTP. Recibe (canal, código).
    /// Debe retornar GuestDataGQL? con los datos del usuario si fue exitoso, null si falló.
    /// </summary>
    [Parameter] public Func<string, string, Task<GuestDataGQL?>>? OnVerifyOtp { get; set; }

    /// <summary>
    /// Callback final que recibe los datos confirmados por el usuario y el código OTP usado.
    /// El padre debe persistir estos cambios en BD usando el código.
    /// </summary>
    [Parameter] public EventCallback<(GuestDataGQL Data, string OtpCode)> OnConfirmData { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private Stage _stage = Stage.SelectChannel;
    private string? _selectedChannel;
    private string? _otpCode;
    private string? _error;

    private string? _editName;
    private string? _editPhone;
    private string? _editEmail;
    private bool _isRegisteredUser;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(ExternalError))
            _error = ExternalError;

        // Auto-seleccionar canal único si solo hay uno disponible
        if (string.IsNullOrEmpty(_selectedChannel))
        {
            if (HasPhone && !HasEmail) _selectedChannel = "sms";
            else if (HasEmail && !HasPhone) _selectedChannel = "email";
        }
    }

    private string GetTitle() => _stage switch
    {
        Stage.SelectChannel => "Verifica tu identidad",
        Stage.EnterOtp => "Ingresa el código",
        Stage.ConfirmData => "Confirma tus datos",
        _ => "Verificación"
    };

    private string GetChannelLabel() => _selectedChannel switch
    {
        "sms" => MaskedPhone ?? "tu teléfono",
        "whatsapp" => MaskedPhone ?? "tu WhatsApp",
        "email" => MaskedEmail ?? "tu email",
        _ => "tu canal"
    };

    private async Task HandleSendOtp()
    {
        if (string.IsNullOrEmpty(_selectedChannel) || OnSendOtp is null) return;
        _error = null;

        var success = await OnSendOtp(_selectedChannel);

        if (success)
            _stage = Stage.EnterOtp;
    }

    private async Task HandleVerifyOtp()
    {
        if (string.IsNullOrEmpty(_otpCode) || _otpCode.Length != 6 || string.IsNullOrEmpty(_selectedChannel)) return;
        if (OnVerifyOtp is null) return;

        _error = null;
        var result = await OnVerifyOtp(_selectedChannel, _otpCode);

        if (result is null)
        {
            _error = "Código incorrecto. Intenta de nuevo.";
            return;
        }

        // Pre-llenar campos con los datos del usuario.
        // Solo los invitados (guests) pueden editarlos; los registrados los ven readonly.
        _isRegisteredUser = string.Equals(result.SessionType, "RegisteredUser", StringComparison.OrdinalIgnoreCase);
        _editName = result.Name;
        _editPhone = result.Phone;
        _editEmail = result.Email;
        _stage = Stage.ConfirmData;
    }

    private async Task HandleConfirmData()
    {
        if (string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editPhone)) return;
        if (string.IsNullOrEmpty(_otpCode)) return;

        var data = new GuestDataGQL
        {
            Name = _editName.Trim(),
            Phone = _editPhone.Trim(),
            Email = (_editEmail ?? "").Trim()
        };

        await OnConfirmData.InvokeAsync((data, _otpCode));
    }

    private void GoBackToChannel()
    {
        _stage = Stage.SelectChannel;
        _otpCode = null;
        _error = null;
    }

    private async Task HandleClose()
    {
        _stage = Stage.SelectChannel;
        _selectedChannel = null;
        _otpCode = null;
        _error = null;
        _editName = null;
        _editPhone = null;
        _editEmail = null;
        _isRegisteredUser = false;
        await OnClose.InvokeAsync();
    }
}
