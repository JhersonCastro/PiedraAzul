} @* fin else modo moderno *@

@code {
    private DotNetObjectReference<Home>? _tourRef;
    private PersistingComponentStateSubscription _sub;
    private bool _tourAlreadySeen;

    protected override void OnInitialized()
    {
        UIModeState.OnSetupComplete += OnSetupComplete;

        _sub = AppState.RegisterOnPersisting(Persist);

        // WASM hydration: leer si el tour ya fue visto, persistido durante SSR
        if (AppState.TryTakeFromJson<bool>("tourSeen_" + TourIds.HomeWelcome, out var seen) && seen)
        {
            _tourAlreadySeen = true;
            return;
        }

        // SSR prerender: leer cookie via implementación server-side
        if (TourSeenReader.IsSeen(TourIds.HomeWelcome))
            _tourAlreadySeen = true;
    }

    private Task Persist()
    {
        AppState.PersistAsJson("tourSeen_" + TourIds.HomeWelcome, _tourAlreadySeen);
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_tourAlreadySeen) return;

            var shouldShow = await DriverTourService.ShouldShowTourAsync(TourIds.HomeWelcome);
            if (shouldShow)
                await StartTourAsync();
        }
    }

    // Llamado por UIModeWelcomeModal cuando el usuario elige un modo por primera vez.
    private void OnSetupComplete(UIMode chosenMode)
    {
        if (chosenMode == UIMode.Modern)
            _ = StartTourAsync();
    }

    private async Task StartTourAsync()
    {
        _tourRef ??= DotNetObjectReference.Create(this);
        await DriverTourService.StartTourAsync(TourIds.HomeWelcome, dotnetRef: _tourRef);
    }

    [JSInvokable]
    public Task TourNavigateToTab(string tab) => Task.CompletedTask;

    public void Dispose()
    {
        UIModeState.OnSetupComplete -= OnSetupComplete;
        _sub.Dispose();
        _tourRef?.Dispose();
    }
}
