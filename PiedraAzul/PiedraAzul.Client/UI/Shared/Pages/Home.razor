@page "/"
@using PiedraAzul.Client.Services
@using PiedraAzul.Client.States
@using PiedraAzul.Client.UI.Features.Account.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@implements IDisposable
@inject DriverTourService DriverTourService
@inject UIModeState UIModeState
@inject ITourSeenReader TourSeenReader
@inject PersistentComponentState AppState

<PageTitle>Piedra Azul</PageTitle>

@if (UIModeState.IsEasy)
{
