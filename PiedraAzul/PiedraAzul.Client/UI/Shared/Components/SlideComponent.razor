<div class="step-slide">
    <p class="step-label">PASO @CurrentStep DE @MaxSteps</p>
    <p class="step-title">@Title</p>
    <div class="step-progress-track">
        <div class="step-progress-bar" style="width:@Progress%"></div>
    </div>
</div>

@code {

    [Parameter, EditorRequired] public string Title { get; set; }
    [Parameter, EditorRequired] public int CurrentStep { get; set; }
    [Parameter, EditorRequired] public int MaxSteps { get; set; }

    private double Progress => (double)CurrentStep / MaxSteps * 100;

}
