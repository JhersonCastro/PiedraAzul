@using PiedraAzul.Client.States
@using PiedraAzul.Client.Services
@inject UIModeState UIModeState
@inject UIModeService UIModeService

<button @onclick="Toggle"
        title="@(UIModeState.IsEasy ? "Cambiar a modo moderno" : "Cambiar a modo fácil")"
        aria-label="@(UIModeState.IsEasy ? "Cambiar a modo moderno" : "Cambiar a modo fácil")"
        class="@ButtonClass">

    @if (UIModeState.IsEasy)
    {
        <!-- Ícono modo fácil activo → cambiar a moderno -->
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <span class="@LabelClass">Moderno</span>
    }
    else
    {
        <!-- Ícono modo moderno → cambiar a fácil -->
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/>
        </svg>
        <span class="@LabelClass">Fácil</span>
    }
</button>

@code {
    /// <summary>Extra CSS classes for the button wrapper.</summary>
    [Parameter] public string Class { get; set; } = "";

    /// <summary>Whether to show the text label next to the icon.</summary>
    [Parameter] public bool ShowLabel { get; set; } = true;

    private string ButtonClass =>
        "uimode-toggle " +
        (UIModeState.IsEasy ? "uimode-toggle-easy" : "uimode-toggle-modern") +
        " " + Class;

    private string LabelClass => ShowLabel ? "" : "sr-only";

    private async Task Toggle() => await UIModeService.ToggleAsync();
}
