@if (Visible)
{
    <div class="overlay-screen">
        <div class="overlay-card">
            <!-- Spinner -->
            <div class="overlay-spinner-wrap">
                <div class="overlay-spinner-track"></div>
                <div class="overlay-spinner-head"></div>
                <svg class="overlay-spinner-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
            </div>
            <div>
                <p class="overlay-title">@Title</p>
                <p class="overlay-sub">@Message</p>
            </div>
            <p class="overlay-note">Por favor, no cierre esta página.</p>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Procesando…";
    [Parameter] public string Message { get; set; } = "Estamos guardando su información. Esto tomará solo un momento.";
}
