@* Tarjeta de menú para Easy Mode (ícono + título + descripción + flecha) *@
<button @onclick="OnClick"
        style="width:100%;display:flex;align-items:center;gap:1rem;background:white;
               border:2px solid #E2E8F0;border-radius:16px;padding:1.25rem;
               cursor:pointer;text-align:left;transition:border-color .15s">
    <span style="font-size:2rem;flex-shrink:0" aria-hidden="true">@Icon</span>
    <div style="flex:1;min-width:0">
        <p style="font-size:1.05rem;font-weight:800;color:#0F172A;margin:0 0 0.2rem">@Title</p>
        <p style="font-size:0.88rem;color:#64748B;margin:0;line-height:1.4">@Description</p>
    </div>
    <svg style="flex-shrink:0;color:#94A3B8" width="20" height="20"
         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="m9 18 6-6-6-6"/>
    </svg>
</button>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
