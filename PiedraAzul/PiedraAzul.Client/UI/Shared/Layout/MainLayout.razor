<!-- BIENVENIDA: selector de modo en primera visita -->
<UIModeWelcomeModal />

<!-- ERROR UI (siempre visible, independiente del modo) -->
<div id="blazor-error-ui" data-nosnippet class="blazor-error">
    <div class="blazor-error-body">
        <svg class="icon-6 mt-0.5 shrink-0 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <circle cx="12" cy="16" r=".5" fill="currentColor"/>
        </svg>
        <div class="flex-1">
            <h2 class="mb-1 text-base font-semibold text-gray-800">Algo no salió como esperábamos</h2>
            <p class="mb-4 text-sm text-gray-500 leading-relaxed">
                No se preocupe, esto a veces ocurre. Puede intentar recargar la página para continuar.
            </p>
            <div class="flex gap-3">
                <a href="." class="reload rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#1E5F6F]">
                    Recargar página
                </a>
                <a class="dismiss cursor-pointer rounded-lg px-4 py-2 text-sm font-medium text-gray-500 transition-colors hover:bg-gray-100">
                    Descartar
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isLoaded = false;
    private bool _isAuthenticated = false;
    private string? _userName;
    private bool _mobileMenuOpen = false;

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;
    private void CloseMobileMenu() => _mobileMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        // Subscribe to mode changes so the layout re-renders instantly
        UIModeState.OnModeChanged += OnUIModeChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            _isAuthenticated = true;

            UserState.User = new UserGQL
            {
                Id             = principal.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "",
                Name           = principal.FindFirst("name")?.Value ?? principal.FindFirst(ClaimTypes.Name)?.Value ?? "",
                Email          = principal.FindFirst(ClaimTypes.Email)?.Value ?? "",
                AvatarUrl      = principal.FindFirst("avatar_url")?.Value ?? "default.png",
                Roles          = principal.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList(),
                EmailConfirmed = true
            };

            _userName = UserState.User.Name;
        }

        _isLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load persisted mode from localStorage (JS interop only available after render)
            await UIModeService.LoadModeAsync();
        }
    }

    private void OnUIModeChanged()
    {
        // Al cambiar a modo fácil, cerrar cualquier tour activo: la UI fácil no tiene anclajes data-tour.
        if (UIModeState.IsEasy)
            _ = DriverTourService.DestroyAsync();

        // Fire StateHasChanged on the render thread
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = DriverTourService.DestroyAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        UIModeState.OnModeChanged -= OnUIModeChanged;
    }
}
