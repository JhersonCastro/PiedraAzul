                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="12" cy="8" r="4"/>
                                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                            </svg>
                            @(_userName?.Split(' ')[0])
                        </a>
                    }
                    else
                    {
                        <a href="/account/auth"
                           style="display:flex;align-items:center;gap:0.5rem;background:white;color:#1E7A87;border-radius:12px;padding:0.6rem 1.4rem;font-size:0.95rem;font-weight:800;text-decoration:none">
                            Ingresar
                        </a>
                    }

