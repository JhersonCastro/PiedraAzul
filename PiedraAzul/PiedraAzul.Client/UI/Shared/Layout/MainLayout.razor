@using PiedraAzul.Client.Services.AuthServices
@using PiedraAzul.Client.Services
@using PiedraAzul.Client.States
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using PiedraAzul.Client.Models.GraphQL

@inject UserState UserState
@inject UIModeState UIModeState
@inject UIModeService UIModeService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject DriverTourService DriverTourService
@inherits LayoutComponentBase
@implements IDisposable

@* Captura el IP real del cliente (prerender) para la auditoría. Invisible. *@
<PiedraAzul.Client.UI.Shared.Components.ClientIpCapture />
@* Lee la cookie uiMode durante SSR para evitar flash al cambiar a modo fácil. Invisible. *@
<PiedraAzul.Client.UI.Shared.Components.UIModeCapture />

@if (UIModeState.IsEasy)
{
    <!-- ══════════════════════════════════════════════════════
         MODO FÁCIL — Interfaz accesible (tercera edad, rural)
         ══════════════════════════════════════════════════════ -->
    <div class="flex min-h-screen flex-col" style="background:#F0F7F8;font-family:'DM Sans',sans-serif">

        <!-- EASY: HEADER -->
        <header style="background:#1E7A87;position:sticky;top:0;z-index:50;box-shadow:0 2px 8px rgba(0,0,0,0.15)">
            <div style="max-width:900px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 1.25rem;height:72px">

                <!-- Logo -->
