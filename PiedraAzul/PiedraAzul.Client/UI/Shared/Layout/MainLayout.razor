                        📞 Llamar: (301) 123-4567
                    </a>
                    <a href="https://wa.me/573128883241" target="_blank"
                       style="display:flex;align-items:center;gap:0.5rem;background:#25D366;color:white;padding:0.8rem 1.5rem;border-radius:12px;text-decoration:none;font-weight:700;font-size:1rem">
                        💬 WhatsApp
                    </a>
                </div>

                <p style="font-size:0.85rem;color:rgba(255,255,255,0.6)">
                    © 2026 Clínica Piedra Azul. Todos los derechos reservados.
                </p>
            </div>
        </footer>

    </div>
}
