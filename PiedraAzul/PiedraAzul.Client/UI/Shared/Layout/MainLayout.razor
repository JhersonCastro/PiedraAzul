                    <span style="font-size:1.4rem;font-weight:800;color:white;letter-spacing:-0.02em">
                        🏥 Piedra Azul
                    </span>
                </a>

                <!-- Navegación fácil (solo lo esencial) -->
                <nav style="display:flex;align-items:center;gap:0.5rem">

                    <!-- Toggle a modo moderno -->
                    <UIModeToggle ShowLabel="true" />

                    @if (!_isLoaded)
                    {
                        <span style="display:flex;align-items:center;gap:0.5rem;background:rgba(255,255,255,0.2);color:white;border-radius:12px;padding:0.6rem 1.2rem;font-size:0.95rem;font-weight:700">
                            Cargando...
